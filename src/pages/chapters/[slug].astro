---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import BookSpine from '../../components/BookSpine.astro';
import ChapterReader from '../../components/ChapterReader.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import ChapterNavigator from '../../components/ChapterNavigator.astro';
import SearchDialog from '../../components/SearchDialog.astro';
import BookMode from '../../components/BookMode.astro';
import ChapterNavigation from '../../components/ChapterNavigation.astro';
import Footer from '../../components/Footer.astro';
import ChapterContent from '../../components/ChapterContent.astro';
import { joinBase } from '../../utils/paths';

// Generate static paths strictly for published chapter slugs
export async function getStaticPaths() {
  const chapters = await getCollection('chapters', ({ data }) => {
    return data.publicationStatus === 'published';
  });
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

// Query all published chapters to establish correct sequencing among published items
const publishedChapters = await getCollection('chapters', ({ data }) => {
  return data.publicationStatus === 'published';
});
const sortedChapters = publishedChapters.sort((a, b) => a.data.order - b.data.order);
const currentIndex = sortedChapters.findIndex((ch) => ch.id === chapter.id);

const prevChapter = currentIndex > 0 ? sortedChapters[currentIndex - 1] : undefined;
const nextChapter = currentIndex < sortedChapters.length - 1 ? sortedChapters[currentIndex + 1] : undefined;

const prevCustomLink = currentIndex === 0 ? {
  href: joinBase('opening/danh-tang'),
  label: "Lời đề từ",
  subtitle: "Dành Tặng"
} : undefined;
---

<BaseLayout 
  title={chapter.data.title} 
  description={chapter.data.description} 
  activeChapterId={chapter.id}
  isReader={true}
>
  <!-- Interactive top progress bar -->
  <ReadingProgress slot="header" />
  <Header slot="header" />

  <!-- Responsive Left Sidebar / Chapter Drawer -->
  <BookSpine activeChapterId={chapter.id} />

  <!-- Center Editorial Reading Panel -->
  <ChapterReader chapterId={chapter.id} chapterTitle={chapter.data.shortTitle} order={chapter.data.order}>
    <!-- Context Menu Toggles for Responsive Breakpoints:
         - Mobile (<1024px): shows both Index (Spine) & On This Chapter (TOC) buttons
         - Tablet (1024px - 1279px): Spine is visible in grid, shows On This Chapter (TOC) trigger button
         - Desktop (>=1280px): both Spine and Right Rail are in grid, toggles hidden
    -->
    <div class="min-[1280px]:hidden flex items-center justify-between border-b border-navy-100 pb-4 mb-6 select-none">
      <div class="flex items-center">
        <button 
          id="mobile-index-btn"
          class="min-[1024px]:hidden flex items-center gap-1.5 px-2.5 py-1.5 text-[11px] font-bold text-navy-600 bg-white border border-navy-100 rounded hover:bg-navy-50 cursor-pointer focus:outline-none"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          Index
        </button>
      </div>

      <button 
        id="mobile-toc-btn"
        class="flex items-center gap-1.5 px-2.5 py-1.5 text-[11px] font-bold text-navy-600 bg-white border border-navy-100 rounded hover:bg-navy-50 cursor-pointer focus:outline-none ml-auto"
      >
        On This Chapter
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

    <!-- Chapter Heading Content -->
    <ChapterHero 
      order={chapter.data.order}
      title={chapter.data.title}
      subtitle={chapter.data.subtitle}
      readingTime={chapter.data.readingTime}
      published={chapter.data.published}
      version={chapter.data.version}
      topics={chapter.data.topics}
      prevChapter={prevChapter}
      nextChapter={nextChapter}
    />

    <!-- Render Markdown Body contents -->
    <ChapterContent chapter={chapter}>
      <Content />
    </ChapterContent>

    <!-- Sequential Pagination -->
    <ChapterNavigation prevChapter={prevChapter} nextChapter={nextChapter} prevCustomLink={prevCustomLink} />
  </ChapterReader>

  <!-- Responsive Right Sidebar / Outliner Tracker -->
  <ChapterNavigator 
    slug={chapter.id}
    version={chapter.data.version}
    readingTime={chapter.data.readingTime}
    topicCount={chapter.data.topics?.length ?? 0}
    navigationPolicy={chapter.data.navigationPolicy}
  />

  <SearchDialog slot="search-dialog" />
  <BookMode slot="search-dialog" />
  <Footer slot="footer" />
</BaseLayout>

<!-- Client scripts to manage responsive drawers and tap-away backdrop interactions -->
<script>
  const mobileIndexBtn = document.getElementById('mobile-index-btn');
  const mobileTocBtn = document.getElementById('mobile-toc-btn');
  const bookSpine = document.getElementById('book-spine');
  const chapterNavigator = document.getElementById('chapter-navigator');

  // Drawer overlay backdrops for easy escape on tap-out
  let overlayBackdrop: HTMLDivElement | null = null;

  function createOverlayBackdrop() {
    if (overlayBackdrop) return;
    overlayBackdrop = document.createElement('div');
    overlayBackdrop.className = 'fixed inset-0 bg-navy-950/20 backdrop-blur-[1px] z-30 transition-opacity duration-200';
    overlayBackdrop.addEventListener('click', closeAllDrawers);
    document.body.appendChild(overlayBackdrop);
  }

  function removeOverlayBackdrop() {
    if (overlayBackdrop) {
      overlayBackdrop.remove();
      overlayBackdrop = null;
    }
  }

  function closeAllDrawers() {
    bookSpine?.classList.remove('mobile-open');
    chapterNavigator?.classList.remove('mobile-open');
    removeOverlayBackdrop();
  }

  mobileIndexBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = bookSpine?.classList.toggle('mobile-open');
    if (isOpen) {
      chapterNavigator?.classList.remove('mobile-open');
      createOverlayBackdrop();
    } else {
      removeOverlayBackdrop();
    }
  });

  mobileTocBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = chapterNavigator?.classList.toggle('mobile-open');
    if (isOpen) {
      bookSpine?.classList.remove('mobile-open');
      createOverlayBackdrop();
    } else {
      removeOverlayBackdrop();
    }
  });

  // Automatically close drawers if transitioning to a higher resolution
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      bookSpine?.classList.remove('mobile-open');
      if (!chapterNavigator?.classList.contains('mobile-open')) {
        removeOverlayBackdrop();
      }
    }
    if (window.innerWidth >= 1280) {
      chapterNavigator?.classList.remove('mobile-open');
      removeOverlayBackdrop();
    }
  });
</script>

<style>
  /* Drawer animations styling on responsive resolutions */
  @media (max-width: 1023px) {
    :global(.spine-container) {
      position: fixed !important;
      top: var(--header-height) !important;
      left: 0 !important;
      bottom: 0 !important;
      z-index: 40 !important;
      transform: translateX(-100%) !important;
      width: min(var(--spine-width), 85vw) !important;
      background-color: white !important;
      box-shadow: var(--shadow-editorial) !important;
      display: flex !important;
      opacity: 1 !important;
    }
    :global(.spine-container.mobile-open) {
      transform: translateX(0) !important;
    }
  }

  @media (max-width: 1279px) {
    :global(.right-rail-container) {
      position: fixed !important;
      top: var(--header-height) !important;
      right: 0 !important;
      bottom: 0 !important;
      z-index: 40 !important;
      transform: translateX(100%) !important;
      width: min(var(--right-rail-width), 85vw) !important;
      background-color: white !important;
      box-shadow: var(--shadow-editorial) !important;
      display: flex !important;
      opacity: 1 !important;
    }
    :global(.right-rail-container.mobile-open) {
      transform: translateX(0) !important;
    }
  }
</style>
