---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SearchDialog from '../../components/SearchDialog.astro';
import Footer from '../../components/Footer.astro';

const baseUrl = import.meta.env.BASE_URL;

// Query openings content collection
const openings = await getCollection('openings');
const entry = openings.find((item) => item.data.id === '02-danh-tang');
const content = entry?.data || {
  sectionLabel: 'LỜI ĐỀ TỪ',
  heading: 'DÀNH TẶNG',
  intro: 'Cho những người đã từng bắt đầu một project rất hào hứng -\nvà rồi tự hỏi vì sao mình chưa thể hoàn thành nó.',
  quoteVi: '“Mỗi ngày đều là một cơ hội mới.\nNgày hôm qua đã kết thúc.\nHôm nay là ngày đầu tiên của tương lai.”',
  quoteEn: '“Each day is a new opportunity. Yesterday is over and done. Today is the first day of my future.”',
  author: 'Louise Hay',
  pageNumber: 'Trang 04'
};

// Find first published chapter for navigation target
const publishedChapters = await getCollection('chapters', ({ data }) => {
  return data.publicationStatus === 'published';
});
const sortedChapters = publishedChapters.sort((a, b) => a.data.order - b.data.order);
const firstChapter = sortedChapters.length > 0 ? sortedChapters[0] : null;
const firstChapterUrl = firstChapter 
  ? `${baseUrl}chapters/${firstChapter.id}`
  : baseUrl;
const firstChapterLabel = firstChapter 
  ? `Bắt đầu đọc sách (${firstChapter.data.order === 0 ? 'Giới thiệu' : `Chương ${firstChapter.data.order}`})`
  : 'Về trang chủ';
---

<BaseLayout 
  title="Dành Tặng — Beyond Vibe Coding" 
  description="Dành tặng — Cho những người đã từng bắt đầu một project rất hào hứng..."
  isReader={false}
>
  <Header slot="header" />

  <!-- Restrained, Quiet, Editorial Book Opening Sequence -->
  <main class="w-full min-h-[calc(100vh-var(--header-height)-80px)] bg-[#f6f8fa] py-8 sm:py-12 px-4 sm:px-6 flex flex-col items-center justify-center select-none">
    
    <!-- Top Editorial Flow Indicator & Navigation -->
    <div class="w-full max-w-2xl mb-6 flex items-center justify-between text-xs text-navy-500 font-sans">
      <!-- Sequence Progress Step -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-navy-100 text-navy-800">
          Trang Mở Đầu
        </span>
        <span class="text-navy-400 font-mono text-[11px]">02 / 02</span>
      </div>

      <!-- Quick Actions: Skip to Published Chapter -->
      <a 
        href={firstChapterUrl}
        class="text-navy-500 hover:text-tech-blue font-semibold text-xs transition-colors flex items-center gap-1 group"
        title="Vào ngay chương sách đã xuất bản"
      >
        <span>Vào sách</span>
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <!-- Authentic Physical Page Representation (Page 04 - DÀNH TẶNG) -->
    <div class="w-full max-w-2xl bg-white rounded-lg sm:rounded-xl border border-navy-200/90 shadow-editorial p-8 sm:p-14 md:p-16 min-h-[620px] sm:min-h-[760px] flex flex-col justify-between relative transition-all duration-300">
      
      <!-- Top Section: Section Heading & Dedication Intro -->
      <div class="flex flex-col items-start pt-2 sm:pt-4">
        <span class="text-xs font-mono font-bold tracking-[0.25em] text-tech-blue uppercase mb-2">
          {content.sectionLabel || "LỜI ĐỀ TỪ"}
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-navy-950 tracking-tight uppercase font-sans">
          {content.heading || "DÀNH TẶNG"}
        </h1>
        <div class="w-12 h-0.5 bg-tech-blue mt-3 mb-4 sm:mb-5"></div>
        
        {content.intro && (
          <p class="text-sm sm:text-base text-navy-700 font-sans leading-relaxed max-w-lg select-text whitespace-pre-line font-medium">
            {content.intro}
          </p>
        )}
      </div>

      <!-- Central Dedicated Quote Block with Generous Editorial Whitespace -->
      <div class="my-auto py-8 sm:py-12 max-w-xl self-center w-full flex flex-col items-center justify-center">
        {content.quoteVi && (
          <blockquote class="text-xl sm:text-2xl md:text-[25px] font-serif italic text-navy-900 leading-relaxed sm:leading-loose text-center select-text mb-4 sm:mb-6">
            {content.quoteVi}
          </blockquote>
        )}

        {content.quoteEn && (
          <blockquote class="text-sm sm:text-base font-serif italic text-navy-500 leading-relaxed text-center select-text max-w-md mx-auto">
            {content.quoteEn}
          </blockquote>
        )}

        {content.author && (
          <div class="mt-6 sm:mt-8 flex flex-col items-center justify-center">
            <cite class="not-italic text-sm sm:text-base font-bold text-navy-800 tracking-wide font-sans">
              — {content.author}
            </cite>
          </div>
        )}
      </div>

      <!-- Subtle Book Footer -->
      <div class="w-full pt-6 border-t border-navy-100 flex items-center justify-between text-[11px] font-mono text-navy-400 select-none">
        <span class="tracking-wider uppercase">BEYOND VIBE CODING</span>
        <span>{content.pageNumber || "Trang 04"}</span>
      </div>

    </div>

    <!-- Paging Controls Bar -->
    <div class="w-full max-w-2xl mt-6 flex items-center justify-between select-none">
      <a 
        href={`${baseUrl}opening/dedication`}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-navy-200 bg-white hover:bg-navy-50 text-navy-700 text-xs font-bold transition-all shadow-2xs group cursor-pointer"
      >
        <span class="transition-transform group-hover:-translate-x-0.5">←</span>
        <span>Trang trước</span>
      </a>

      <a 
        href={firstChapterUrl}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-tech-blue hover:bg-blue-700 text-white text-xs font-bold transition-all shadow-2xs group cursor-pointer"
      >
        <span>{firstChapterLabel}</span>
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

  </main>

  <SearchDialog slot="search-dialog" />
  <Footer slot="footer" />
</BaseLayout>
