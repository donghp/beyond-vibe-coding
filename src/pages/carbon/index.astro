---
import fs from 'node:fs';
import path from 'node:path';

// Read root /carbon/index.html
const carbonHtmlPath = path.join(process.cwd(), 'carbon', 'index.html');
let carbonHtml = '';
try {
  carbonHtml = fs.readFileSync(carbonHtmlPath, 'utf-8');
} catch (e) {
  carbonHtml = '<html><body>ENERIX Carbon index.html not found</body></html>';
}
---

<div id="carbon-astro-root" set:html={carbonHtml} />

<script>
  // Dynamic import of carbon app if on /carbon route
  import('/carbon/app/app.js').catch(() => {
    // Fallback module import
  });
</script>
