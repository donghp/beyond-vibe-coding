---
import { joinBase } from '../utils/paths';

/**
 * Beyond Vibe Coding — Author Bonus Component (Ủng hộ tác giả)
 *
 * An elegant, non-intrusive way for readers to optionally support the author.
 * Completely optional — reading remains 100% free.
 */

interface BonusOption {
  id: string;
  amount: string;
  rawAmount: number;
  label: string;
  icon: string;
  message: string;
  qrFile: string;
}

const bonusOptions: BonusOption[] = [
  {
    id: '30k',
    amount: '30.000đ',
    rawAmount: 30000,
    label: 'Một chén trà',
    icon: '🍵',
    message: 'Ghi nhận công sức cặm cụi gõ phím và thiết kế của tác giả.',
    qrFile: 'BONUS_30K.png',
  },
  {
    id: '50k',
    amount: '50.000đ',
    rawAmount: 50000,
    label: 'Một ly cà phê',
    icon: '☕',
    message: 'Đọc khá cuốn, có thêm nhiều góc nhìn tham khảo tốt.',
    qrFile: 'BONUS_50K.png',
  },
  {
    id: '100k',
    amount: '100.000đ',
    rawAmount: 100000,
    label: 'Một chầu nước hoa quả',
    icon: '🍹',
    message: 'Góc nhìn hữu ích, mở ra thêm nhiều cách tiếp cận mới với AI.',
    qrFile: 'BONUS_100K.png',
  },
  {
    id: '200k',
    amount: '200.000đ',
    rawAmount: 200000,
    label: 'Vài vại bia mát',
    icon: '🍺',
    message: 'Thực chiến, kiến trúc rõ ràng và gỡ rối được nhiều vấn đề.',
    qrFile: 'BONUS_200K.png',
  },
  {
    id: '300k',
    amount: '300.000đ',
    rawAmount: 300000,
    label: 'Một chầu xôm tụ',
    icon: '🎉',
    message: 'Kiến thức xuất sắc, thay đổi hoàn toàn tư duy làm hệ thống của tôi!',
    qrFile: 'BONUS_300K.png',
  },
];
---

<!-- Fixed bottom-right trigger button -->
<div 
  id="author-bonus-trigger-container"
  class="fixed bottom-6 right-6 z-30 flex items-center select-none"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <button
    id="author-bonus-open-btn"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="author-bonus-dialog"
    aria-label="Ủng hộ tác giả — Hoàn toàn tự nguyện"
    class="flex items-center gap-2 px-3.5 py-2.5 bg-white/95 backdrop-blur-sm border border-navy-200/90 hover:border-tech-blue/50 text-navy-800 hover:text-navy-950 rounded-xl shadow-editorial hover:shadow-md transition-all duration-200 group cursor-pointer focus:outline-none focus:ring-2 focus:ring-tech-blue/30"
  >
    <!-- Coffee / Heart icon -->
    <span class="text-sm leading-none flex items-center justify-center filter grayscale group-hover:grayscale-0 transition-all">☕</span>
    <span class="text-xs font-semibold tracking-tight text-navy-900 group-hover:text-tech-blue transition-colors">
      Ủng hộ tác giả
    </span>
    <span class="text-xs text-rose-500/90 group-hover:text-rose-600 transition-colors leading-none">❤️</span>
  </button>
</div>

<!-- Modal Dialog / Bottom Sheet Panel -->
<div 
  id="author-bonus-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="author-bonus-title"
  aria-hidden="true"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center opacity-0 pointer-events-none transition-all duration-200"
>
  <!-- Backdrop -->
  <div 
    id="author-bonus-backdrop"
    class="fixed inset-0 bg-navy-950/40 backdrop-blur-[2px] transition-opacity duration-200 cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Modal Container -->
  <div 
    id="author-bonus-panel"
    class="relative z-10 w-full sm:max-w-xl max-h-[92vh] sm:max-h-[85vh] overflow-y-auto bg-white rounded-t-2xl sm:rounded-2xl border border-navy-100/80 shadow-2xl p-5 sm:p-7 flex flex-col gap-5 transform translate-y-6 sm:translate-y-0 sm:scale-95 transition-all duration-200"
    style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem));"
  >
    <!-- Header -->
    <div class="flex items-start justify-between gap-4 pb-3 border-b border-navy-100">
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-2">
          <span class="text-base">☕</span>
          <h3 id="author-bonus-title" class="text-base sm:text-lg font-bold text-navy-950 tracking-tight">
            Nếu cuốn sách này hữu ích với bạn...
          </h3>
        </div>
        <p class="text-xs sm:text-[13px] text-navy-600 leading-relaxed">
          Bạn có thể ủng hộ tác giả một chút bonus. Hoàn toàn tự nguyện — đọc tiếp miễn phí vẫn rất vui.
        </p>
      </div>

      <button
        id="author-bonus-close-btn"
        type="button"
        aria-label="Đóng bảng ủng hộ tác giả"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-navy-400 hover:text-navy-900 hover:bg-navy-50 transition-colors shrink-0 focus:outline-none focus:ring-2 focus:ring-tech-blue/30 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- 5 Friendly Choices Selector -->
    <div class="flex flex-col gap-2">
      <span class="text-[11px] font-bold uppercase tracking-wider text-navy-400 select-none">
        Chọn mức ủng hộ tùy tâm:
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" role="tablist" aria-label="Các mức ủng hộ tác giả">
        {bonusOptions.map((opt, idx) => (
          <button
            type="button"
            role="tab"
            id={`bonus-tab-${opt.id}`}
            aria-selected={idx === 1 ? 'true' : 'false'}
            aria-controls={`bonus-panel-${opt.id}`}
            data-option-id={opt.id}
            class={`bonus-tab-btn flex flex-col items-center justify-center p-2.5 rounded-xl border transition-all duration-150 cursor-pointer text-center select-none ${
              idx === 1 
                ? 'border-tech-blue bg-tech-blue/8 text-navy-950 font-bold shadow-xs' 
                : 'border-navy-100 hover:border-navy-200 bg-navy-50/40 hover:bg-navy-50 text-navy-700'
            }`}
          >
            <span class="text-base mb-0.5 leading-none">{opt.icon}</span>
            <span class="text-xs font-bold text-navy-950 tracking-tight leading-tight">{opt.amount}</span>
            <span class="text-[10px] text-navy-500 font-medium truncate w-full mt-0.5">{opt.label}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Details Display Area -->
    <div class="bg-navy-50/50 border border-navy-100 rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row items-center gap-5">
      <!-- QR Image Container -->
      <div class="relative w-48 h-48 sm:w-44 sm:h-44 bg-white rounded-lg p-2.5 border border-navy-200/80 shadow-xs shrink-0 flex items-center justify-center">
        {bonusOptions.map((opt, idx) => {
          const primarySrc = joinBase(`images/bonus/${opt.qrFile}`);
          const fallbackSrc1 = joinBase(`images/${opt.qrFile}`);
          const fallbackSrc2 = joinBase(opt.qrFile);

          return (
            <img 
              id={`bonus-qr-img-${opt.id}`}
              src={primarySrc}
              data-fallback-1={fallbackSrc1}
              data-fallback-2={fallbackSrc2}
              alt={`Mã VietQR ủng hộ tác giả ${opt.amount} (${opt.label})`}
              width="200"
              height="200"
              loading="lazy"
              referrerpolicy="no-referrer"
              class={`bonus-qr-image w-full h-full object-contain rounded transition-opacity duration-200 ${
                idx === 1 ? 'block opacity-100' : 'hidden opacity-0'
              }`}
              onerror={`
                if (this.getAttribute('data-tried') !== '2') {
                  if (!this.getAttribute('data-tried')) {
                    this.setAttribute('data-tried', '1');
                    this.src = this.getAttribute('data-fallback-1');
                  } else {
                    this.setAttribute('data-tried', '2');
                    this.src = this.getAttribute('data-fallback-2');
                  }
                }
              `}
            />
          );
        })}
      </div>

      <!-- Detail message & description -->
      <div class="flex-1 flex flex-col gap-2.5 text-center sm:text-left min-w-0">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5">
          <span id="bonus-active-badge-amount" class="text-sm font-bold text-navy-950 tracking-tight">
            50.000đ
          </span>
          <span class="text-xs text-navy-400">•</span>
          <span id="bonus-active-badge-label" class="text-xs font-semibold text-tech-blue">
            Một ly cà phê ☕
          </span>
        </div>

        <blockquote 
          id="bonus-active-message"
          class="text-xs sm:text-[13px] text-navy-700 italic bg-white border-l-2 border-tech-blue/80 p-2.5 rounded-r-md leading-relaxed"
        >
          "Đọc khá cuốn, có thêm nhiều góc nhìn tham khảo tốt."
        </blockquote>

        <p class="text-[11px] text-navy-500 leading-relaxed font-normal">
          Quét mã VietQR bằng bất kỳ ứng dụng ngân hàng hoặc ví điện tử nào để gửi bonus trực tiếp đến tác giả.
        </p>
      </div>
    </div>

    <!-- Editorial Footer Message -->
    <div class="pt-3 border-t border-navy-100 flex flex-col gap-1 text-center sm:text-left">
      <p class="text-xs text-navy-600 leading-relaxed">
        Mỗi sự ủng hộ, dù nhỏ, đều giúp cuốn sách này đi xa hơn. Cảm ơn bạn đã là một phần của hành trình này.
      </p>
      <span class="text-[11px] text-navy-400 font-medium">
        — Tác giả Beyond Vibe Coding
      </span>
    </div>
  </div>
</div>

<script>
  // Client-side interactions for Author Bonus Modal
  const openBtn = document.getElementById('author-bonus-open-btn');
  const closeBtn = document.getElementById('author-bonus-close-btn');
  const backdrop = document.getElementById('author-bonus-backdrop');
  const dialog = document.getElementById('author-bonus-dialog');
  const panel = document.getElementById('author-bonus-panel');
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.bonus-tab-btn');
  const qrImages = document.querySelectorAll<HTMLImageElement>('.bonus-qr-image');
  
  const badgeAmount = document.getElementById('bonus-active-badge-amount');
  const badgeLabel = document.getElementById('bonus-active-badge-label');
  const activeMessage = document.getElementById('bonus-active-message');

  const optionsData: Record<string, { amount: string; label: string; icon: string; message: string }> = {
    '30k': {
      amount: '30.000đ',
      label: 'Một chén trà',
      icon: '🍵',
      message: 'Ghi nhận công sức cặm cụi gõ phím và thiết kế của tác giả.',
    },
    '50k': {
      amount: '50.000đ',
      label: 'Một ly cà phê',
      icon: '☕',
      message: 'Đọc khá cuốn, có thêm nhiều góc nhìn tham khảo tốt.',
    },
    '100k': {
      amount: '100.000đ',
      label: 'Một chầu nước hoa quả',
      icon: '🍹',
      message: 'Góc nhìn hữu ích, mở ra thêm nhiều cách tiếp cận mới với AI.',
    },
    '200k': {
      amount: '200.000đ',
      label: 'Vài vại bia mát',
      icon: '🍺',
      message: 'Thực chiến, kiến trúc rõ ràng và gỡ rối được nhiều vấn đề.',
    },
    '300k': {
      amount: '300.000đ',
      label: 'Một chầu xôm tụ',
      icon: '🎉',
      message: 'Kiến thức xuất sắc, thay đổi hoàn toàn tư duy làm hệ thống của tôi!',
    },
  };

  let isBonusOpen = false;

  function openBonusDialog() {
    if (!dialog || isBonusOpen) return;
    isBonusOpen = true;
    dialog.classList.remove('opacity-0', 'pointer-events-none');
    dialog.classList.add('opacity-100', 'pointer-events-auto');
    dialog.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');

    if (panel) {
      panel.classList.remove('translate-y-6', 'sm:scale-95');
      panel.classList.add('translate-y-0', 'sm:scale-100');
    }

    closeBtn?.focus();
  }

  function closeBonusDialog() {
    if (!dialog || !isBonusOpen) return;
    isBonusOpen = false;
    dialog.classList.remove('opacity-100', 'pointer-events-auto');
    dialog.classList.add('opacity-0', 'pointer-events-none');
    dialog.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');

    if (panel) {
      panel.classList.remove('translate-y-0', 'sm:scale-100');
      panel.classList.add('translate-y-6', 'sm:scale-95');
    }

    openBtn?.focus();
  }

  function selectOption(optionId: string) {
    const data = optionsData[optionId];
    if (!data) return;

    // Update tabs
    tabBtns.forEach((btn) => {
      const isSelected = btn.getAttribute('data-option-id') === optionId;
      btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      if (isSelected) {
        btn.className = 'bonus-tab-btn flex flex-col items-center justify-center p-2.5 rounded-xl border transition-all duration-150 cursor-pointer text-center select-none border-tech-blue bg-tech-blue/8 text-navy-950 font-bold shadow-xs';
      } else {
        btn.className = 'bonus-tab-btn flex flex-col items-center justify-center p-2.5 rounded-xl border transition-all duration-150 cursor-pointer text-center select-none border-navy-100 hover:border-navy-200 bg-navy-50/40 hover:bg-navy-50 text-navy-700';
      }
    });

    // Update QR image visibility
    qrImages.forEach((img) => {
      if (img.id === `bonus-qr-img-${optionId}`) {
        img.classList.remove('hidden', 'opacity-0');
        img.classList.add('block', 'opacity-100');
      } else {
        img.classList.remove('block', 'opacity-100');
        img.classList.add('hidden', 'opacity-0');
      }
    });

    // Update text
    if (badgeAmount) badgeAmount.textContent = data.amount;
    if (badgeLabel) badgeLabel.textContent = `${data.label} ${data.icon}`;
    if (activeMessage) activeMessage.textContent = `"${data.message}"`;
  }

  // Event Listeners
  openBtn?.addEventListener('click', openBonusDialog);
  closeBtn?.addEventListener('click', closeBonusDialog);
  backdrop?.addEventListener('click', closeBonusDialog);

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const optionId = btn.getAttribute('data-option-id');
      if (optionId) selectOption(optionId);
    });
  });

  // Global ESC key listener for dialog
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isBonusOpen) {
      e.stopPropagation();
      closeBonusDialog();
    }
  });
</script>
