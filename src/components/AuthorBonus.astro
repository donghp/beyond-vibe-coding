<script>
  // Client-side controller for Author Bonus Dialog
  const openBtn = document.getElementById('author-bonus-open-btn');
  const closeBtn = document.getElementById('author-bonus-close-btn');
  const bottomCloseBtn = document.getElementById('author-bonus-bottom-close-btn');
  const backdrop = document.getElementById('author-bonus-backdrop');
  const dialog = document.getElementById('author-bonus-dialog');
  const panel = document.getElementById('author-bonus-panel');

  let isBonusOpen = false;

  function openBonusDialog() {
    if (!dialog || isBonusOpen) return;
    isBonusOpen = true;
    dialog.classList.remove('opacity-0', 'pointer-events-none');
    dialog.classList.add('opacity-100', 'pointer-events-auto');
    dialog.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');

    if (panel) {
      panel.classList.remove('translate-y-6', 'sm:scale-[0.97]');
      panel.classList.add('translate-y-0', 'sm:scale-100');
    }

    closeBtn?.focus();
  }

  function closeBonusDialog() {
    if (!dialog || !isBonusOpen) return;
    isBonusOpen = false;
    dialog.classList.remove('opacity-100', 'pointer-events-auto');
    dialog.classList.add('opacity-0', 'pointer-events-none');
    dialog.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');

    if (panel) {
      panel.classList.remove('translate-y-0', 'sm:scale-100');
      panel.classList.add('translate-y-6', 'sm:scale-[0.97]');
    }

    openBtn?.focus();
  }

  // Event Listeners
  openBtn?.addEventListener('click', openBonusDialog);
  closeBtn?.addEventListener('click', closeBonusDialog);
  bottomCloseBtn?.addEventListener('click', closeBonusDialog);
  backdrop?.addEventListener('click', closeBonusDialog);

  // Global ESC key listener
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isBonusOpen) {
      e.stopPropagation();
      closeBonusDialog();
    }
  });
</script>

