---
import { joinBase } from '../utils/paths';

/**
 * Beyond Vibe Coding — Author Bonus Component (Ủng hộ tác giả)
 *
 * Visual Refinement Pass (#000027.BVC):
 * - Quiet editorial author-appreciation moment matching BYC_BONUS_DESIGN.png
 * - Soft tinted card backgrounds and understated borders (no payment UI look)
 * - Refined proportions: [ILLUSTRATION] [CONTENT] [QR] with wide text breathing room
 * - Sits gracefully on desktop and mobile with ultra-thin scrollbar and iOS safe areas
 * - Non-commercial, warm, and friendly
 */

interface BonusItem {
  id: string;
  amount: string;
  itemName: string;
  quote: string;
  secondary: string;
  qrFile: string;
  qrAlt: string;
  qrLabel: string;
  bgTint: string;
  borderTint: string;
  iconBg: string;
}

const bonusItems: BonusItem[] = [
  {
    id: '30k',
    amount: '30.000đ',
    itemName: 'Chén trà',
    quote: '“Ghi nhận công sức cặm cụi gõ phím và thiết kế của tác giả.”',
    secondary: 'Một chén trà ấm, thêm động lực. 🍃',
    qrFile: 'BONUS_30K.png',
    qrAlt: 'Mã QR ủng hộ tác giả 30.000đ',
    qrLabel: 'QR 30K',
    bgTint: 'bg-[#f7fbf2]',
    borderTint: 'border-[#e4f0d7]',
    iconBg: 'bg-[#ecf6df]',
  },
  {
    id: '50k',
    amount: '50.000đ',
    itemName: 'Ly cà phê',
    quote: '“Đọc khá cuốn, có thêm nhiều góc nhìn tham khảo tốt.”',
    secondary: 'Một ly cà phê để tỉnh táo viết tiếp. ☕',
    qrFile: 'BONUS_50K.png',
    qrAlt: 'Mã QR ủng hộ tác giả 50.000đ',
    qrLabel: 'QR 50K',
    bgTint: 'bg-[#fbf7f0]',
    borderTint: 'border-[#f2e7d3]',
    iconBg: 'bg-[#f7eedc]',
  },
  {
    id: '100k',
    amount: '100.000đ',
    itemName: 'Chầu nước hoa quả',
    quote: '“Góc nhìn sắc bén, mở ra nhiều cách tiếp cận mới với AI.”',
    secondary: 'Một chầu nước hoa quả, cho ngày dài sáng tạo. 🍹',
    qrFile: 'BONUS_100K.png',
    qrAlt: 'Mã QR ủng hộ tác giả 100.000đ',
    qrLabel: 'QR 100K',
    bgTint: 'bg-[#fef9f2]',
    borderTint: 'border-[#fde7ce]',
    iconBg: 'bg-[#feeeda]',
  },
  {
    id: '200k',
    amount: '200.000đ',
    itemName: 'Vài vại bia mát',
    quote: '“Thực chiến, kiến trúc rõ ràng và gỡ rối được nhiều vấn đề.”',
    secondary: 'Vài vại bia để ăn mừng những ý tưởng hay. 🍻',
    qrFile: 'BONUS_200K.png',
    qrAlt: 'Mã QR ủng hộ tác giả 200.000đ',
    qrLabel: 'QR 200K',
    bgTint: 'bg-[#f3f9fe]',
    borderTint: 'border-[#dceefa]',
    iconBg: 'bg-[#e4f2fc]',
  },
  {
    id: '300k',
    amount: '300.000đ',
    itemName: 'Một chầu xôm tụ',
    quote: '“Kiến thức xuất sắc, thay đổi hoàn toàn tư duy làm hệ thống của tôi!”',
    secondary: 'Một chầu xôm tụ để cùng chúc mừng. 🎉',
    qrFile: 'BONUS_300K.png',
    qrAlt: 'Mã QR ủng hộ tác giả 300.000đ',
    qrLabel: 'QR 300K',
    bgTint: 'bg-[#fef4f6]',
    borderTint: 'border-[#fbdee3]',
    iconBg: 'bg-[#fde5ea]',
  },
];
---

<!-- Fixed bottom-right trigger button replacing old ENTER BOOK MODE -->
<div 
  id="author-bonus-trigger-container"
  class="fixed bottom-5 right-5 z-30 flex items-center select-none"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <button
    id="author-bonus-open-btn"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="author-bonus-dialog"
    aria-label="Ủng hộ tác giả — Hoàn toàn tự nguyện"
    class="flex items-center gap-2 px-3.5 py-2 bg-white/95 backdrop-blur-md border border-slate-200/90 hover:border-tech-blue/50 text-slate-800 hover:text-tech-blue rounded-full shadow-editorial hover:shadow-md transition-all duration-200 group cursor-pointer focus:outline-none focus:ring-2 focus:ring-tech-blue/30"
  >
    <span class="text-sm leading-none">☕</span>
    <span class="text-xs font-semibold tracking-tight transition-colors">
      Ủng hộ tác giả
    </span>
    <span class="text-xs text-rose-500 group-hover:scale-110 transition-transform leading-none">❤️</span>
  </button>
</div>

<!-- Modal Dialog / Bottom Sheet Panel matching BYC_BONUS_DESIGN.png -->
<div 
  id="author-bonus-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="author-bonus-heading"
  aria-describedby="author-bonus-desc"
  aria-hidden="true"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center opacity-0 pointer-events-none transition-all duration-200 ease-out p-0 sm:p-4"
>
  <!-- Backdrop -->
  <div 
    id="author-bonus-backdrop"
    class="fixed inset-0 bg-navy-950/40 backdrop-blur-[2px] transition-opacity duration-200 cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Modal Container matching refined design -->
  <div 
    id="author-bonus-panel"
    class="relative z-10 w-full sm:max-w-xl md:max-w-2xl max-h-[90vh] sm:max-h-[86vh] overflow-y-auto bg-white rounded-t-[28px] sm:rounded-[24px] border border-slate-200/70 shadow-xl p-4 sm:p-6 md:p-7 flex flex-col gap-3.5 transform translate-y-6 sm:translate-y-0 sm:scale-[0.97] transition-all duration-200 ease-out scrollbar-thin"
    style="padding-bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem));"
  >
    <!-- Mobile top drag indicator handle -->
    <div class="sm:hidden w-10 h-1 bg-slate-300/80 rounded-full mx-auto -mt-1 mb-1"></div>

    <!-- Header Section -->
    <div class="relative flex items-start justify-between gap-3">
      <div class="flex flex-col flex-1 pr-8 sm:pr-2">
        <!-- Eyebrow Gratitude Line -->
        <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-semibold text-[#0284c7] uppercase tracking-wider mb-1">
          <span>CẢM ƠN BẠN ĐÃ ĐỒNG HÀNH!</span>
          <span class="text-rose-500">❤️</span>
        </div>

        <!-- Main Headline -->
        <h2 id="author-bonus-heading" class="text-base sm:text-xl font-bold text-slate-900 tracking-tight leading-snug mb-1.5">
          Nếu cuốn sách này hữu ích với bạn...
        </h2>

        <!-- Supporting Explanation Body -->
        <p id="author-bonus-desc" class="text-xs sm:text-[13px] text-slate-600 leading-relaxed max-w-sm sm:max-w-md">
          Bạn có thể ủng hộ tác giả một chút bonus. Điều này giúp tôi có thêm năng lượng để tiếp tục viết, chia sẻ và cập nhật những nội dung chất lượng hơn. Hoàn toàn tự nguyện — đọc tiếp miễn phí vẫn rất vui! 😊
        </p>
      </div>

      <!-- Mascot Illustration (Author with warm mug & inspirational quote) - Compact & in top-right corner -->
      <div class="hidden sm:flex flex-col items-center justify-center shrink-0 w-24 relative select-none mr-6 -mt-1">
        <svg viewBox="0 0 140 140" class="w-20 h-20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Ambient soft cloud / glow -->
          <circle cx="75" cy="70" r="48" fill="#f0f9ff" />
          <path d="M100 35C108 35 115 42 115 50C115 52 114 54 113 56C118 58 122 64 122 70C122 78 116 84 108 84L45 84C38 84 32 78 32 71C32 64 37 59 43 58C43 48 51 40 61 40C64 40 68 41 71 43C76 38 83 35 91 35Z" fill="#e0f2fe" opacity="0.6"/>
          
          <!-- Inspiration curved text & sparks -->
          <path id="curve-path-refined" d="M 68 44 Q 95 24 128 46" fill="transparent" />
          <text font-family="system-ui, -apple-system, sans-serif" font-size="7" font-style="italic" font-weight="600" fill="#0284c7">
            <textPath href="#curve-path-refined">
              Good ideas make a brighter tomorrow
            </textPath>
          </text>
          
          <!-- Radiating spark rays -->
          <path d="M102 18L104 23M116 22L114 26M92 20L95 24" stroke="#38bdf8" stroke-width="1.2" stroke-linecap="round"/>
          
          <!-- Floating Heart -->
          <path d="M124 55C124 52.8 122.2 51 120 51C118.5 51 117.2 51.9 116.6 53.2C116 51.9 114.7 51 113.2 51C111 51 109.2 52.8 109.2 55C109.2 58 114 62 116.6 64C119.2 62 124 58 124 55Z" fill="#ef4444"/>

          <!-- Character: Head & Hair -->
          <circle cx="68" cy="72" r="21" fill="#fed7aa"/>
          <path d="M47 68C47 52 57 44 71 44C83 44 91 52 89 65C87 63 83 61 80 62C77 63 75 66 73 67C71 63 67 61 62 61C57 61 52 64 50 67C48 67 47 68 47 68Z" fill="#1e293b"/>
          <path d="M48 62C46 55 52 48 60 46C65 45 72 45 77 47C84 50 88 56 89 63C86 58 80 56 74 57C69 58 65 62 62 64C59 60 54 58 48 62Z" fill="#0f172a"/>

          <!-- Face details: eyes smiling, blushing cheeks, smile -->
          <path d="M58 70C60 68 63 68 65 70" stroke="#0f172a" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M72 70C74 68 77 68 79 70" stroke="#0f172a" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M68 76C68 78 69.5 80 71 80C72.5 80 74 78 74 76" stroke="#0f172a" stroke-width="1.8" stroke-linecap="round" fill="#fda4af"/>
          <circle cx="56" cy="75" r="2.5" fill="#fca5a5" opacity="0.6"/>
          <circle cx="81" cy="75" r="2.5" fill="#fca5a5" opacity="0.6"/>

          <!-- Body & Arms holding coffee mug -->
          <path d="M52 93C52 87 59 84 69 84C79 84 86 87 86 93L88 120H50L52 93Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5"/>
          <path d="M54 94C56 99 64 104 74 104C78 104 84 100 85 95" stroke="#0f172a" stroke-width="1.8" fill="none" stroke-linecap="round"/>

          <!-- Coffee mug with Heart -->
          <rect x="68" y="94" width="22" height="20" rx="3" fill="#ffffff" stroke="#0284c7" stroke-width="2"/>
          <path d="M90 98C94 98 96 101 96 104C96 107 94 110 90 110" stroke="#0284c7" stroke-width="2" fill="none"/>
          <path d="M81 101C81 99.8 80 99 79 99C78.2 99 77.5 99.5 77 100.2C76.5 99.5 75.8 99 75 99C74 99 73 99.8 73 101C73 102.5 76 105 77 106C78 105 81 102.5 81 101Z" fill="#ef4444"/>
          <path d="M74 90C73 87 75 85 74 82" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M80 90C81 87 79 85 80 82" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Top-right Close Button -->
      <button
        id="author-bonus-close-btn"
        type="button"
        aria-label="Đóng bảng ủng hộ tác giả"
        class="w-7 h-7 rounded-full bg-slate-100/80 hover:bg-slate-200/90 text-slate-400 hover:text-slate-700 flex items-center justify-center transition-colors shrink-0 focus:outline-none focus:ring-2 focus:ring-tech-blue/30 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Editorial Micro Section Divider -->
    <div class="flex items-center gap-2.5 my-0.5">
      <div class="h-[1px] bg-sky-100 flex-1"></div>
      <span class="text-[9.5px] sm:text-[10.5px] font-semibold text-[#0284c7]/80 uppercase tracking-widest select-none shrink-0">
        MỘT CHÚT BONUS, NẾU BẠN MUỐN
      </span>
      <div class="h-[1px] bg-sky-100 flex-1"></div>
    </div>

    <!-- Five Bonus Cards List matching visual layout in BYC_BONUS_DESIGN.png -->
    <div class="flex flex-col gap-2.5 sm:gap-3">
      {bonusItems.map((item) => {
        const primarySrc = joinBase(`images/bonus/${item.qrFile}`);
        const fallbackSrc = joinBase(`images/${item.qrFile}`);
        const fallbackRoot = joinBase(item.qrFile);

        return (
          <div 
            id={`bonus-card-${item.id}`}
            class={`flex items-center justify-between gap-2.5 sm:gap-3.5 p-2.5 sm:p-3 rounded-2xl border ${item.borderTint} ${item.bgTint} hover:shadow-xs transition-all duration-150`}
          >
            {/* Left Area: Warm Themed Vector Illustration */}
            <div class={`w-14 h-14 sm:w-16 sm:h-16 md:w-18 md:h-18 rounded-xl ${item.iconBg} border border-white/60 shadow-2xs flex items-center justify-center shrink-0 p-1 overflow-hidden select-none`}>
              {item.id === '30k' && (
                <svg viewBox="0 0 64 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <ellipse cx="32" cy="48" rx="22" ry="5" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="1.5"/>
                  <ellipse cx="32" cy="47" rx="16" ry="3" fill="#f1f5f9"/>
                  <path d="M18 30C18 42 24 45 32 45C40 45 46 42 46 30H18Z" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5"/>
                  <ellipse cx="32" cy="30" rx="14" ry="4" fill="#84cc16"/>
                  <ellipse cx="32" cy="30" rx="11" ry="2.5" fill="#a3e635"/>
                  <path d="M44 32C48 32 50 35 50 38C50 41 48 43 43 43" stroke="#94a3b8" stroke-width="1.5" fill="none"/>
                  <path d="M12 40C12 40 16 35 20 38C20 38 18 44 12 40Z" fill="#65a30d"/>
                  <path d="M14 43C14 43 19 40 23 44C23 44 19 48 14 43Z" fill="#4d7c0f"/>
                  <path d="M44 24C44 24 48 18 53 20C53 20 52 26 44 24Z" fill="#65a30d"/>
                  <path d="M28 24C27 21 29 19 28 16" stroke="#a3e635" stroke-width="1.2" stroke-linecap="round"/>
                  <path d="M34 23C35 20 33 18 34 15" stroke="#a3e635" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              )}

              {item.id === '50k' && (
                <svg viewBox="0 0 64 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <ellipse cx="32" cy="48" rx="22" ry="5" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="1.5"/>
                  <ellipse cx="32" cy="47" rx="16" ry="3" fill="#f8fafc"/>
                  <path d="M17 28C17 42 23 45 32 45C41 45 47 42 47 28H17Z" fill="#ffffff" stroke="#94a3b8" stroke-width="1.5"/>
                  <ellipse cx="32" cy="28" rx="15" ry="4.5" fill="#78350f"/>
                  <ellipse cx="32" cy="28" rx="12" ry="3" fill="#92400e"/>
                  <ellipse cx="32" cy="28" rx="8" ry="1.8" fill="#b45309"/>
                  <path d="M45 31C50 31 52 34 52 37C52 40 50 42 44 42" stroke="#94a3b8" stroke-width="1.5" fill="none"/>
                  <ellipse cx="14" cy="48" rx="4" ry="2.5" transform="rotate(-20 14 48)" fill="#451a03"/>
                  <path d="M12 47Q14 48 16 49" stroke="#78350f" stroke-width="0.8"/>
                  <ellipse cx="20" cy="51" rx="3.5" ry="2.2" transform="rotate(15 20 51)" fill="#451a03"/>
                  <path d="M18 51Q20 51 22 51" stroke="#78350f" stroke-width="0.8"/>
                  <path d="M29 22C28 19 30 17 29 14" stroke="#d97706" stroke-width="1.2" stroke-linecap="round"/>
                  <path d="M35 21C36 18 34 16 35 13" stroke="#d97706" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              )}

              {item.id === '100k' && (
                <svg viewBox="0 0 64 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22 20L25 50C25 52 28 53 32 53C36 53 39 52 39 50L42 20H22Z" fill="#fed7aa" stroke="#94a3b8" stroke-width="1.5" opacity="0.9"/>
                  <path d="M23 25L25.5 49C25.5 50.5 28 51.5 32 51.5C36 51.5 38.5 50.5 38.5 49L41 25H23Z" fill="#ea580c"/>
                  <ellipse cx="32" cy="25" rx="9" ry="2" fill="#fb923c"/>
                  <rect x="27" y="30" width="6" height="6" rx="1" fill="#ffffff" opacity="0.6"/>
                  <rect x="31" y="38" width="5" height="5" rx="1" fill="#ffffff" opacity="0.6"/>
                  <path d="M34 12L38 28L35 44" stroke="#0284c7" stroke-width="2" stroke-linecap="round"/>
                  <path d="M34 12L36 20" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="21" cy="24" r="8" fill="#f97316" stroke="#c2410c" stroke-width="1"/>
                  <circle cx="21" cy="24" r="6.5" fill="#fdba74"/>
                  <circle cx="21" cy="24" r="2" fill="#ffffff"/>
                  <path d="M21 18L21 30M15 24L27 24M17 20L25 28M17 28L25 20" stroke="#f97316" stroke-width="0.8"/>
                </svg>
              )}

              {item.id === '200k' && (
                <svg viewBox="0 0 64 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g transform="rotate(10 24 40)">
                    <rect x="18" y="24" width="14" height="22" rx="3" fill="#fbbf24" stroke="#78350f" stroke-width="1.2"/>
                    <path d="M18 28H32M18 34H32M18 40H32" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="2 2"/>
                    <path d="M18 28C14 28 13 32 13 35C13 38 14 42 18 42" stroke="#78350f" stroke-width="1.5" fill="none"/>
                    <path d="M16 24C16 21 19 20 22 21C24 19 28 19 30 21C33 20 35 22 34 24Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                  </g>
                  <g transform="rotate(-10 40 40)">
                    <rect x="32" y="24" width="14" height="22" rx="3" fill="#fbbf24" stroke="#78350f" stroke-width="1.2"/>
                    <path d="M32 28H46M32 34H46M32 40H46" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="2 2"/>
                    <path d="M46 28C50 28 51 32 51 35C51 38 50 42 46 42" stroke="#78350f" stroke-width="1.5" fill="none"/>
                    <path d="M30 24C30 21 33 20 36 21C38 19 42 19 44 21C47 20 49 22 48 24Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1"/>
                  </g>
                  <path d="M32 16L32 12M30 14L34 14M28 18L26 16M36 18L38 16" stroke="#f59e0b" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              )}

              {item.id === '300k' && (
                <svg viewBox="0 0 64 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="24" r="5" fill="#fed7aa"/>
                  <path d="M12 22C12 18 16 16 20 18C20 20 18 22 18 24" fill="#1e293b"/>
                  <path d="M10 36C10 31 13 29 18 29C23 29 24 31 24 36Z" fill="#3b82f6"/>
                  <circle cx="27" cy="21" r="5.5" fill="#fcd34d"/>
                  <path d="M22 19C23 15 29 14 32 17C31 19 29 21 28 23" fill="#0f172a"/>
                  <path d="M21 36C21 29 25 27 30 27C35 27 37 29 37 36Z" fill="#10b981"/>
                  <circle cx="39" cy="22" r="5" fill="#fed7aa"/>
                  <path d="M35 18C36 15 42 16 44 19C43 21 40 22 39 24" fill="#b91c1c"/>
                  <path d="M33 36C33 30 36 28 41 28C46 28 48 30 48 36Z" fill="#f59e0b"/>
                  <circle cx="49" cy="25" r="4.5" fill="#fde047"/>
                  <path d="M45 22C46 19 51 19 53 22" fill="#1e293b"/>
                  <path d="M44 36C44 32 47 30 51 30C55 30 56 32 56 36Z" fill="#ec4899"/>
                  <path d="M8 38C8 36 12 35 32 35C52 35 56 36 56 38L54 52H10L8 38Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.2"/>
                  <ellipse cx="22" cy="40" rx="4.5" ry="1.5" fill="#f87171"/>
                  <ellipse cx="32" cy="41" rx="6" ry="2" fill="#fbbf24"/>
                  <ellipse cx="42" cy="40" rx="4.5" ry="1.5" fill="#34d399"/>
                  <circle cx="12" cy="14" r="1" fill="#f43f5e"/>
                  <circle cx="50" cy="15" r="1" fill="#3b82f6"/>
                  <circle cx="32" cy="12" r="1.2" fill="#eab308"/>
                  <path d="M16 11L18 13M44 11L46 13" stroke="#8b5cf6" stroke-width="1" stroke-linecap="round"/>
                </svg>
              )}
            </div>

            {/* Middle Area: Title, Quote & Friendly Note with generous breathing space */}
            <div class="flex-1 flex flex-col min-w-0 px-1 sm:px-2">
              <h3 class="text-xs sm:text-sm md:text-[14.5px] font-bold text-slate-800 tracking-tight leading-snug">
                {item.amount} <span class="font-normal text-slate-400">—</span> {item.itemName}
              </h3>

              <p class="text-[11.5px] sm:text-xs text-slate-600 leading-snug mt-0.5 sm:mt-1 font-normal line-clamp-2">
                {item.quote}
              </p>

              <span class="text-[10.5px] sm:text-[11.5px] text-slate-500 font-normal mt-0.5 sm:mt-1 flex items-center gap-1">
                {item.secondary}
              </span>
            </div>

            {/* Right Area: Crisp VietQR Code Card in refined soft container */}
            <div class="w-[70px] sm:w-[82px] shrink-0 bg-white/95 rounded-xl border border-slate-200/70 p-1 sm:p-1.5 flex flex-col items-center justify-center shadow-2xs">
              <div class="w-13 h-13 sm:w-15 sm:h-15 flex items-center justify-center relative bg-white">
                <img 
                  id={`qr-img-${item.id}`}
                  src={primarySrc}
                  data-fallback-1={fallbackSrc}
                  data-fallback-2={fallbackRoot}
                  alt={item.qrAlt}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-contain select-none"
                  onerror={`
                    if (this.getAttribute('data-tried') !== '2') {
                      if (!this.getAttribute('data-tried')) {
                        this.setAttribute('data-tried', '1');
                        this.src = this.getAttribute('data-fallback-1');
                      } else {
                        this.setAttribute('data-tried', '2');
                        this.src = this.getAttribute('data-fallback-2');
                      }
                    }
                  `}
                />
              </div>
              <span class="text-[9.5px] sm:text-[10.5px] font-semibold text-slate-400 tracking-tight mt-0.5 select-none">
                {item.qrLabel}
              </span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Closing Gratitude Block matching BYC_BONUS_DESIGN.png -->
    <div class="rounded-2xl bg-[#f0f7ff]/75 border border-[#d8e9fc]/80 p-3 sm:p-3.5 flex items-center gap-3 mt-0.5 select-none">
