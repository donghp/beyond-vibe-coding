---
import { joinBase } from '../utils/paths';

interface Props {
  order: number;
  title: string;
  subtitle?: string;
  readingTime: string;
  published: string;
  version: string;
  topics: string[];
  prevChapter?: { id: string; data: { order: number; shortTitle: string } };
  nextChapter?: { id: string; data: { order: number; shortTitle: string } };
}

const { order, title, subtitle, prevChapter, nextChapter } = Astro.props;
const chapterIndexStr = order.toString().padStart(2, '0');

// Format title semantic split: split into two lines on period or question mark if available
let line1 = title;
let line2 = "";

if (title.includes('.')) {
  const parts = title.split('.');
  line1 = parts[0].trim() + '.';
  line2 = parts.slice(1).join('.').trim();
} else if (title.includes(' - ')) {
  const parts = title.split(' - ');
  line1 = parts[0].trim();
  line2 = parts.slice(1).join(' - ').trim();
}
---

<header class="w-full pb-4 mb-6 flex flex-col select-none">
  <!-- Top Breadcrumb & Chapter Paging Header -->
  <div class="flex items-center justify-between text-xs font-semibold text-navy-500 pb-5 border-b border-navy-100/80 mb-6">
    <nav class="flex items-center gap-2" aria-label="breadcrumb">
      <a href={joinBase('')} class="text-navy-700 hover:text-tech-blue transition-colors">Home</a>
      <span class="text-navy-300">›</span>
      <a href={joinBase('#chapters')} class="text-navy-700 hover:text-tech-blue transition-colors">Chapters</a>
      <span class="text-navy-300">›</span>
      <span class="text-navy-950 font-bold">{order === 0 ? 'Lời mở đầu' : `Chương ${order}`}</span>
    </nav>

    <!-- Paging Links -->
    <div class="flex items-center gap-3 text-xs font-medium">
      {prevChapter ? (
        <a 
          href={joinBase(`chapters/${prevChapter.id}`)} 
          class="text-navy-700 hover:text-tech-blue transition-colors flex items-center gap-1 font-semibold"
          title={prevChapter.data.order === 0 ? 'Lời mở đầu' : `Chương ${prevChapter.data.order}: ${prevChapter.data.shortTitle}`}
        >
          ← {prevChapter.data.order === 0 ? 'Lời mở đầu' : `Chương ${prevChapter.data.order}`}
        </a>
      ) : (
        <span class="text-navy-300">← Bắt đầu</span>
      )}
      
      <span class="text-navy-300">|</span>

      {nextChapter ? (
        <a 
          href={joinBase(`chapters/${nextChapter.id}`)} 
          class="text-navy-700 hover:text-tech-blue transition-colors flex items-center gap-1 font-semibold"
          title={nextChapter.data.order === 0 ? 'Lời mở đầu' : `Chương ${nextChapter.data.order}: ${nextChapter.data.shortTitle}`}
        >
          {nextChapter.data.order === 0 ? 'Lời mở đầu' : `Chương ${nextChapter.data.order}`} →
        </a>
      ) : (
        <span class="text-navy-300">Kết thúc →</span>
      )}
    </div>
  </div>

  <!-- Chapter Number & Editorial Epigraph in row -->
  <div class="flex items-start justify-between gap-4 mb-2">
    <div>
      <span class="text-xs font-sans font-bold tracking-[0.25em] text-tech-blue uppercase">
        {order === 0 ? 'LỜI MỞ ĐẦU' : `CHƯƠNG ${order}`}
      </span>
    </div>

    <!-- Editorial Quote in Header (as seen in mockup) -->
    <div class="hidden sm:flex flex-col text-right max-w-sm">
      <p class="text-xs text-navy-600 italic leading-snug">
        “AI is powerful. But power without permission is not progress.”
      </p>
      <span class="text-[10px] font-bold text-navy-400 uppercase tracking-wider mt-0.5">
        — BEYOND VIBE CODING
      </span>
    </div>
  </div>

  <!-- Large Dominant Chapter Title -->
  <h1 class="text-3xl sm:text-4xl md:text-[44px] lg:text-5xl font-extrabold tracking-[-0.022em] leading-[1.12] font-sans text-navy-950 uppercase mb-3">
    {line1}
    {line2 && (
      <span class="block text-tech-blue mt-1">
        {line2}
      </span>
    )}
  </h1>

  <!-- Chapter Subtitle -->
  {subtitle && (
    <p class="text-base sm:text-lg text-navy-600 font-medium leading-relaxed tracking-tight max-w-[65ch] mt-1">
      {subtitle}
    </p>
  )}

  <!-- Thin Blue Horizontal Rule -->
  <div class="w-full h-[2px] bg-tech-blue my-5"></div>

  <!-- Chapter Hero Visual Banner -->
  <div class="w-full aspect-[21/9] rounded-xl bg-navy-950 overflow-hidden relative shadow-sm border border-navy-100/80 my-1">
    <!-- Authentic Hero Image -->
    <img 
      src={joinBase(`images/chapter-${chapterIndexStr}-hero.webp`)} 
      alt={`Chương ${order} Hero Visual`}
      class="w-full h-full object-cover object-center"
      loading="eager"
    />

    <!-- Elegant Editorial Overlay preserved as approved system -->
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950/75 via-navy-950/45 to-navy-950/15 flex items-center justify-between px-6 py-4 sm:px-10 sm:py-6 select-text">
      <div class="flex flex-col gap-1 text-white">
        <span class="text-[11px] sm:text-xs md:text-sm font-extrabold tracking-widest uppercase font-sans text-white/95">
          BETTER TOOLS.
        </span>
        <span class="text-[11px] sm:text-xs md:text-sm font-extrabold tracking-widest uppercase font-sans text-white/95">
          A MORE INTENTIONAL YOU.
        </span>
        <span class="text-[11px] sm:text-xs md:text-sm font-extrabold tracking-widest uppercase font-sans text-white/95">
          A BRIGHTER TOMORROW.
        </span>
      </div>

      <div class="hidden sm:flex flex-col gap-1 text-right text-white/85 font-mono text-[10px] sm:text-[11px] tracking-wider uppercase">
        <span class="text-cyan-restrained font-bold">HUMAN INTENTION</span>
        <span class="text-white/75">AI CAPABILITY</span>
        <span class="text-emerald-400 font-bold">REAL VALUE</span>
      </div>
    </div>
  </div>
</header>
