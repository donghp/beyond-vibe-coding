---
/**
 * BVC Master Visual Design - Architecture Renderer (VG-ARCHITECTURE)
 * VERSION: "1.1"
 */
import type { VisualAST } from '../../lib/visual/visualAst';
import { decodeVisualText } from '../../lib/visual/utils';

interface Props {
  ast: VisualAST;
}

const { ast } = Astro.props;

const isCh07Arch = ast.nodes.some(n => n.label === 'PROJECT');
---

<div class="bvc-diagram-engine mx-auto max-w-2xl w-full" data-type="VG-ARCHITECTURE">
  {isCh07Arch ? (
    <div class="bvc-visual-surface p-12 overflow-hidden relative">
      <div class="flex flex-col items-center space-y-12">
        <div class="bvc-arch-anchor">Project</div>
        
        <div class="w-full flex justify-center items-center relative py-6">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-[85%] h-[1px] bg-slate-100"></div>
          </div>
          <div class="grid grid-cols-3 gap-6 w-full relative">
             <div class="bg-white border border-slate-200 py-5 text-center shadow-sm z-10 rounded-sm">
               <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Method</span>
             </div>
             <div class="bg-white border border-slate-200 py-5 text-center shadow-sm z-10 rounded-sm">
               <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Governance</span>
             </div>
             <div class="bg-white border border-slate-200 py-5 text-center shadow-sm z-10 rounded-sm">
               <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">State</span>
             </div>
          </div>
        </div>

        <div class="flex flex-col items-center w-full space-y-10">
          <div class="w-px h-10 bg-slate-100"></div>
          <div class="bvc-arch-contract">Semantic Contract</div>
          <div class="w-px h-10 bg-slate-100"></div>
          <div class="bvc-arch-adapter w-full max-w-xs">Executor Adapters</div>
          
          <div class="grid grid-cols-2 gap-16 relative w-full max-w-md pt-6">
            <div class="absolute top-0 left-1/4 right-1/4 h-[1px] bg-slate-50"></div>
             <div class="flex flex-col items-center space-y-4">
                <div class="w-16 h-16 rounded-full border border-slate-100 flex items-center justify-center bg-slate-50/30">
                   <span class="text-[11px] font-black text-slate-300 tracking-tighter">AI A</span>
                </div>
             </div>
             <div class="flex flex-col items-center space-y-4">
                <div class="w-16 h-16 rounded-full border border-slate-100 flex items-center justify-center bg-slate-50/30">
                   <span class="text-[11px] font-black text-slate-300 tracking-tighter">AI B</span>
                </div>
             </div>
          </div>

          <div class="w-full flex flex-col items-center space-y-8 pt-6">
             <div class="bvc-arch-execution w-full max-w-sm">Execution</div>
             <div class="bvc-arch-verification w-full max-w-sm">
               <div class="flex items-center space-x-3">
                 <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                 <span>Verification</span>
               </div>
             </div>
             <div class="bg-slate-50 border border-slate-100 h-14 w-full max-w-sm flex items-center justify-center text-slate-400 rounded-sm">
               <span class="text-[11px] font-black tracking-[0.2em] uppercase">State Update</span>
             </div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="bvc-visual-surface p-8 overflow-x-auto">
      <div class="flex items-center space-x-2 mb-6 border-b border-slate-100 pb-4">
        <div class="w-2 h-2 rounded-full bg-blue-500"></div>
        <span class="bvc-section-label">System Architecture</span>
      </div>
      <pre class="font-mono text-[12px] leading-[1.8] text-slate-600 whitespace-pre tabular-nums">{decodeVisualText(ast.raw.trim())}</pre>
    </div>
  )}
</div>
