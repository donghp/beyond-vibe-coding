---
/**
 * BVC Master Visual Design - Decision Renderer (VG-DECISION)
 * Standard: BVC MVEA-001 — LIGHT VISUAL CANVAS RULE
 * VERSION: "2.0"
 */
import type { VisualAST } from '../../lib/visual/visualAst';
import { decodeVisualText } from '../../lib/visual/utils';

interface Props {
  ast: VisualAST;
}

const { ast } = Astro.props;
---

<div class="bvc-visual-surface bg-white p-8 mx-auto max-w-2xl w-full border border-[#E2E8F0] shadow-sm">
  <div class="flex items-center space-x-2 mb-6 border-b border-[#E2E8F0] pb-4">
    <div class="w-1.5 h-1.5 rounded-full bg-[#F59E0B]"></div>
    <span class="bvc-section-label text-[#0B1D3A]">Decision Logic</span>
  </div>
  <pre class="font-mono text-[12px] leading-[1.8] text-[#0B1D3A] whitespace-pre tabular-nums">{decodeVisualText(ast.raw.trim())}</pre>
</div>
