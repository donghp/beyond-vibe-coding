---
/**
 * BVC Master Visual Design - Visual Section Label Primitive
 * Inspired by BVC Glossary micro-typography & section labels
 * Standard: BVC MVEA-001 — LIGHT VISUAL CANVAS RULE
 * VERSION: "2.0"
 */

interface Props {
  label: string;
  dotColor?: 'sky' | 'emerald' | 'amber' | 'deep-blue' | 'slate';
  class?: string;
}

const {
  label,
  dotColor = 'sky',
  class: className = ''
} = Astro.props;

const dotClasses = {
  sky: 'bg-[#0EA5E9]',
  emerald: 'bg-[#22C55E]',
  amber: 'bg-[#F59E0B]',
  'deep-blue': 'bg-[#0B1D3A]',
  slate: 'bg-[#64748B]'
}[dotColor];
---

<div class={`bvc-visual-section-label inline-flex items-center space-x-2 text-[10px] md:text-[11px] font-black uppercase tracking-[0.25em] text-[#0B1D3A] ${className}`}>
  <span class={`w-2 h-2 rounded-full ${dotClasses}`}></span>
  <span>{label}</span>
</div>
