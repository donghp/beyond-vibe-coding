---
/**
 * BVC Master Visual Design - Visual Group Primitive
 * Inspired by BVC Glossary semantic boundary groups
 * Standard: BVC MVEA-001 — LIGHT VISUAL CANVAS RULE
 * VERSION: "2.0"
 */

interface Props {
  title?: string;
  badge?: string;
  surface?: 'slate' | 'sky' | 'white';
  class?: string;
}

const {
  title,
  badge,
  surface = 'slate',
  class: className = ''
} = Astro.props;

const surfaceClasses = {
  slate: 'bg-[#F8FAFC] border-slate-300',
  sky: 'bg-[#F0F7FF] border-[#BAE6FD]',
  white: 'bg-white border-[#E2E8F0]'
}[surface];
---

<div class={`bvc-visual-group rounded-[20px] border-1.5 border-dashed ${surfaceClasses} p-6 relative ${className}`}>
  {(title || badge) && (
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200/60">
      {title && (
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#64748B]">
          {title}
        </span>
      )}
      {badge && (
        <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-[0.18em] bg-white border border-slate-200 text-[#0B1D3A]">
          {badge}
        </span>
      )}
    </div>
  )}
  <slot />
</div>
