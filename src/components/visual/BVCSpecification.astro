---
/**
 * BVC Master Visual Design - Specification Renderer (VG-SPEC)
 * VERSION: "1.1"
 */
import type { VisualAST } from '../../lib/visual/visualAst';
import { decodeVisualText } from '../../lib/visual/utils';

interface Props {
  ast: VisualAST;
}

const { ast } = Astro.props;
---

<div class="mx-auto max-w-2xl w-full my-8">
  <div class="bg-[#F8FAFC] border border-slate-200 rounded-sm overflow-hidden">
    <div class="bg-slate-50 px-5 py-3 border-b border-slate-200 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <div class="w-1.5 h-1.5 rounded-full bg-blue-600"></div>
        <span class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em]">Engineering Method</span>
      </div>
      <div class="text-[9px] font-mono text-slate-400 uppercase tracking-widest">BVC-SPEC-V1</div>
    </div>
    <div class="p-5 space-y-0.5">
      {ast.nodes.map(node => (
        node.subLabel ? (
          <div class="grid grid-cols-[140px_1fr] gap-4 py-1.5 items-baseline border-b border-slate-100/50 last:border-0">
            <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">{decodeVisualText(node.label)}</div>
            <div class="font-mono text-[13px] text-slate-800 tabular-nums">
              {decodeVisualText(node.subLabel)}
            </div>
          </div>
        ) : (
           <div class="text-[12px] font-black text-blue-600/80 mt-6 mb-3 uppercase tracking-[0.15em] border-b border-blue-100 pb-1 first:mt-0">{decodeVisualText(node.label)}</div>
        )
      ))}
    </div>
  </div>
</div>
