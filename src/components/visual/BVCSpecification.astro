---
/**
 * BVC Master Visual Design - Specification Renderer (VG-SPEC)
 * Standard: BVC MVEA-001 — LIGHT VISUAL CANVAS RULE
 * VERSION: "2.0"
 */
import type { VisualAST } from '../../lib/visual/visualAst';
import { decodeVisualText } from '../../lib/visual/utils';

interface Props {
  ast: VisualAST;
}

const { ast } = Astro.props;
---

<div class="mx-auto max-w-2xl w-full my-8">
  <div class="bg-white border border-[#E2E8F0] rounded-2xl overflow-hidden shadow-[0_4px_12px_-2px_rgba(11,29,58,0.03)]">
    <div class="bg-[#F0F7FF] px-6 py-3.5 border-b border-[#E2E8F0] flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-2 h-2 rounded-full bg-[#0EA5E9]"></div>
        <span class="text-[10px] font-black text-[#0B1D3A] uppercase tracking-[0.2em]">Engineering Method</span>
      </div>
      <div class="text-[9px] font-mono text-[#64748B] uppercase tracking-widest">BVC-SPEC-V1</div>
    </div>
    <div class="p-6 space-y-1 bg-white">
      {ast.nodes.map(node => (
        node.subLabel ? (
          <div class="grid grid-cols-[140px_1fr] gap-4 py-2 items-baseline border-b border-[#F1F5F9] last:border-0">
            <div class="text-[11px] font-bold text-[#64748B] uppercase tracking-wider">{decodeVisualText(node.label)}</div>
            <div class="font-mono text-[13px] text-[#0B1D3A] bg-[#F3F6F9] px-3 py-1 rounded-lg tabular-nums w-fit border border-[#E2E8F0]">
              {decodeVisualText(node.subLabel)}
            </div>
          </div>
        ) : (
          <div class="text-[12px] font-black text-[#0B1D3A] mt-6 mb-3 uppercase tracking-[0.15em] border-b border-[#EAF6FF] pb-1 first:mt-0">{decodeVisualText(node.label)}</div>
        )
      ))}
    </div>
  </div>
</div>
