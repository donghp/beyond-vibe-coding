---
/**
 * BVC Master Visual Design - Technical Icon Library
 * VERSION: "2.0"
 */

interface Props {
  name: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const { name, class: className = "text-current", size = 24, strokeWidth = 1.5 } = Astro.props;

// Use Lucide-inspired but custom BVC-refined technical paths
---

<svg
