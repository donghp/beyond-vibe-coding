---
/**
 * BVC Master Visual Design - Checklist Renderer (VG-CHECKLIST)
 * VERSION: "1.1"
 */
import type { VisualAST } from '../../lib/visual/visualAst';
import { decodeVisualText } from '../../lib/visual/utils';

interface Props {
  ast: VisualAST;
}

const { ast } = Astro.props;
---

<div class="bvc-visual-surface p-8 mx-auto max-w-2xl w-full">
   <div class="bvc-section-label mb-6 border-b border-slate-50 pb-4">Status Checklist</div>
   <div class="space-y-4">
     {ast.nodes.map(node => (
       <div class="flex items-center justify-between py-2.5 border-b border-slate-50 last:border-0">
         <span class="text-[13px] font-medium text-slate-700 tracking-tight">{decodeVisualText(node.label)}</span>
         <div class="flex items-center">
            {node.status === 'PASS' && (
              <span class="bvc-status-pill bvc-status-pass">PASS</span>
            )}
            {node.status === 'FAIL' && (
              <span class="bvc-status-pill bvc-status-fail">FAIL</span>
            )}
            {node.status === 'NONE' && node.subLabel && (
              <span class="text-[11px] font-black text-blue-600 uppercase tracking-widest">{decodeVisualText(node.subLabel)}</span>
            )}
         </div>
       </div>
     ))}
   </div>
</div>
