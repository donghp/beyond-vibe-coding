---
/**
 * BVC Master Visual Design - Checklist Renderer (VG-CHECKLIST)
 * VERSION: "1.1"
 */
import type { VisualAST } from '../../lib/visual/visualAst';
import { decodeVisualText } from '../../lib/visual/utils';

interface Props {
  ast: VisualAST;
}

const { ast } = Astro.props;
---

<div class="bvc-visual-surface p-6 md:p-8 mx-auto max-w-2xl w-full bg-white border border-[#E2E8F0] rounded-2xl shadow-[0_4px_12px_-2px_rgba(11,29,58,0.03)]">
   <div class="flex items-center space-x-2.5 mb-6 border-b border-[#E2E8F0] pb-4">
     <div class="w-2 h-2 rounded-full bg-[#0EA5E9]"></div>
     <span class="text-[10px] md:text-[11px] font-black uppercase tracking-[0.25em] text-[#0B1D3A]">Status Checklist</span>
   </div>
   <div class="space-y-1">
     {ast.nodes.map(node => (
       <div class="flex items-center justify-between py-3 border-b border-[#F1F5F9] last:border-0">
         <span class="text-[13px] font-medium text-[#0B1D3A] tracking-tight">{decodeVisualText(node.label)}</span>
         <div class="flex items-center">
            {node.status === 'PASS' && (
              <span class="bvc-status-pill bvc-status-pass">PASS</span>
            )}
            {node.status === 'FAIL' && (
              <span class="bvc-status-pill bvc-status-fail">FAIL</span>
            )}
            {node.status === 'NONE' && node.subLabel && (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-[0.18em] bg-[#F0F7FF] text-[#0EA5E9] border border-[#E0F2FE]">{decodeVisualText(node.subLabel)}</span>
            )}
         </div>
       </div>
     ))}
   </div>
</div>
