---
/**
 * BVC Master Visual Design - Semantic Components
 * VERSION: "2.0"
 */
import Shape from '../primitives/Shape.astro';
import TechnicalIcon from '../icons/TechnicalIcon.astro';

interface Props {
  type: string;
  id: string;
  label: string;
  subLabel?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  status?: string;
}

const { 
  type, 
  id, 
  label, 
  subLabel, 
  x = 0, 
  y = 0, 
  width = 140, 
  height = 80,
  status
} = Astro.props;

// Map semantic types to primitive shapes and icons
const mapping: Record<string, { shape: string; icon?: string; colorClass?: string }> = {
  'database': { shape: 'cylinder', icon: 'database', colorClass: 'fill-sky-50/50 stroke-sky-200' },
  'vector-store': { shape: 'cylinder', icon: 'vector-store', colorClass: 'fill-sky-50/70 stroke-sky-300' },
  'document': { shape: 'document', icon: 'document', colorClass: 'fill-[#F8FAFC] stroke-slate-200' },
  'stacked-documents': { shape: 'stacked-documents', icon: 'document', colorClass: 'fill-[#F8FAFC] stroke-slate-200' },
  'model': { shape: 'rounded-rectangle', icon: 'model', colorClass: 'fill-sky-50/50 stroke-sky-200' },
  'llm': { shape: 'rounded-rectangle', icon: 'llm', colorClass: 'fill-[#F0F7FF] stroke-sky-200' },
  'user': { shape: 'ellipse', icon: 'user', colorClass: 'fill-[#F8FAFC] stroke-slate-200' },
  'query': { shape: 'pill', icon: 'query', colorClass: 'fill-sky-50 stroke-sky-200' },
  'search': { shape: 'ellipse', icon: 'search', colorClass: 'fill-sky-50 stroke-sky-200' },
  'retriever': { shape: 'hexagon', icon: 'retriever', colorClass: 'fill-teal-50/40 stroke-teal-200' },
  'chunk': { shape: 'rectangle', icon: 'chunk', colorClass: 'fill-amber-50/40 stroke-amber-200' },
  'metadata': { shape: 'pill', icon: 'metadata', colorClass: 'fill-[#F8FAFC] stroke-slate-200' },
  'index': { shape: 'rectangle', icon: 'index', colorClass: 'fill-[#F8FAFC] stroke-slate-200' },
  'evidence': { shape: 'document', icon: 'evidence', colorClass: 'fill-emerald-50/50 stroke-emerald-200' },
  'decision': { shape: 'diamond', colorClass: 'fill-amber-50/40 stroke-amber-200' },
  'process-step': { shape: 'rounded-rectangle', colorClass: 'fill-white stroke-slate-200' },
  'boundary': { shape: 'bracket', colorClass: 'stroke-slate-300 stroke-dasharray-4' },
  'container': { shape: 'rectangle', colorClass: 'fill-[#F8FAFC] stroke-slate-200 stroke-dasharray-4' }
};

const config = mapping[type] || { shape: 'rounded-rectangle', colorClass: 'fill-white stroke-slate-200' };

// Handle status-based colors
let statusClass = config.colorClass;
if (status === 'PASS' || status === 'VERIFIED') statusClass = 'fill-emerald-50/60 stroke-emerald-300';
if (status === 'FAIL' || status === 'REJECTED') statusClass = 'fill-rose-50/60 stroke-rose-300';
if (status === 'PENDING') statusClass = 'fill-amber-50/60 stroke-amber-300';

---

<g id={id} transform={`translate(${x}, ${y})`} class="bvc-semantic-component">
  <Shape 
    type={config.shape} 
    width={width} 
    height={height} 
    class={statusClass}
  />
  
  {config.icon && (
    <g transform={`translate(${width/2 - 12}, 12)`} class="opacity-50 text-slate-500">
      <TechnicalIcon name={config.icon} size={24} strokeWidth={1.75} />
    </g>
  )}

  <text 
    x={width / 2} 
    y={config.icon ? height / 2 + 15 : height / 2 + 5} 
    text-anchor="middle" 
    class="text-[12px] md:text-[13px] font-black fill-[#0B1D3A] tracking-wider uppercase select-none pointer-events-none"
  >
    {label}
  </text>
  
  {subLabel && (
    <text 
      x={width / 2} 
      y={config.icon ? height / 2 + 32 : height / 2 + 22} 
      text-anchor="middle" 
      class="text-[10px] md:text-[11px] fill-[#64748B] italic font-medium select-none pointer-events-none"
    >
      {subLabel}
    </text>
  )}

  {status && (
    <g transform={`translate(${width - 24}, 8)`}>
      {status === 'VERIFIED' || status === 'PASS' ? (
        <circle cx="8" cy="8" r="8" class="fill-[#22C55E]" />
        <path d="M5 8l2 2 4-4" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      ) : status === 'REJECTED' || status === 'FAIL' ? (
        <circle cx="8" cy="8" r="8" class="fill-[#DC2626]" />
        <path d="M5 5l6 6M11 5l-6 6" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      ) : null}
    </g>
  )}
</g>
