---
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="w-full bg-[#fbfbfd] border-t border-navy-100 py-8 px-6 select-none mt-auto transition-all duration-300 footer-container">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-navy-500">
    
    <!-- Brand / Copyright -->
    <div class="flex items-center gap-3">
      <span class="font-medium">Copyright @ 2026 Hồng Đông - <a href="mailto:sugiharavn@gmail.com" class="hover:text-tech-blue transition-colors" aria-label="Email Hồng Đông">Email : sugiharavn@gmail.com</a></span>
    </div>

    <!-- Navigation / Source links -->
    <div class="flex items-center gap-5 font-medium">
      <a href={baseUrl} class="hover:text-tech-blue transition-colors">Home</a>
      <a href={`${baseUrl}#chapters`} class="hover:text-tech-blue transition-colors">Chapters</a>
      <a href="https://github.com/donghp/beyond-vibe-coding" target="_blank" rel="noopener noreferrer" class="hover:text-tech-blue transition-colors inline-flex items-center gap-1">
        <span>GitHub</span>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>

  </div>
</footer>

<style>
  /* Collapse/Fade out footer in Book Mode on Desktop */
  :global(.book-mode-active) .footer-container {
    opacity: 0.1;
    border-color: transparent;
  }
</style>
