---
/**
 * BVC Master Visual Design - Featured Concept Component
 * VERSION: "1.0"
 */
import { getTermById } from '../../lib/terminology/authority';

interface Props {
  termId?: string;
}

const { termId = 'context' } = Astro.props;
const term = getTermById(termId);

// Conceptual map items for the "Context" visual
const relatedNodes = [
  { label: 'TASK', role: 'flow' },
  { label: 'AUTHORITY', role: 'structure' },
  { label: 'STATE', role: 'structure' },
  { label: 'VERIFICATION', role: 'verified' }
];
---

<section class="featured-concept bg-[#F3F6F9] border border-slate-200/60 rounded-2xl p-8 space-y-8 sticky top-24">
  <div class="space-y-2">
    <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.25em]">Khái niệm nổi bật</h3>
    <h2 class="text-3xl font-black text-[#0B1D3A] tracking-tight uppercase">{term?.canonicalTerm || 'Context'}</h2>
  </div>

  <!-- Semantic Map Visual -->
  <div class="relative h-64 flex items-center justify-center bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <!-- Center Node -->
    <div class="z-10 w-24 h-24 rounded-full bg-[#0B1D3A] flex items-center justify-center text-white text-[10px] font-black tracking-widest shadow-xl shadow-blue-900/20">
      {term?.canonicalTerm.toUpperCase() || 'CONTEXT'}
    </div>

    <!-- Relationship Lines & Nodes -->
    {relatedNodes.map((node, i) => {
      const angle = (i * 90) * (Math.PI / 180);
      const x = Math.cos(angle) * 80;
      const y = Math.sin(angle) * 80;
      
      const colors = {
        structure: 'bg-[#0B1D3A] text-white',
        flow: 'bg-[#0EA5E9] text-white',
        verified: 'bg-[#22C55E] text-white'
      };

      return (
        <>
          <div 
            class="absolute w-[1.5px] bg-slate-200 origin-center"
            style={`height: 80px; left: 50%; top: 50%; transform: translate(-50%, -100%) rotate(${i * 90}deg); transform-origin: 50% 100%;`}
          ></div>
          <div 
            class={`absolute w-20 py-2 rounded-lg text-center text-[8px] font-black tracking-widest shadow-sm ${colors[node.role as keyof typeof colors]}`}
            style={`left: calc(50% + ${x}px); top: calc(50% + ${y}px); transform: translate(-50%, -50%);`}
          >
            {node.label}
          </div>
        </>
      );
    })}
  </div>

  <div class="space-y-4">
    <p class="text-sm text-slate-600 font-medium leading-relaxed">
      "Không phải cứ có nhiều thông tin là AI sẽ làm đúng. Điều quan trọng là AI nhận đúng thứ nó cần."
    </p>
    <a href={`/glossary?term=${termId}`} class="inline-flex items-center text-[10px] font-black text-[#0EA5E9] uppercase tracking-widest hover:text-[#0B1D3A] transition-colors">
      <span>Xem phân tích</span>
      <svg class="w-3 h-3 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</section>
