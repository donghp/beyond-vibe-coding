---
// Prompt-ID: #000010
// Prompt-Title: BVC CHAPTER 13 — STRICT 7-VISUAL LOCK / APPROVED VISUAL WHITELIST / TEXT-ONLY EVERYTHING ELSE

import BVCVisualFrame from './visual/BVCVisualFrame.astro';
import BVCFlow from './visual/BVCFlow.astro';
import BVCActionScope from './visual/BVCActionScope.astro';
import BVCDiagramRenderer from './visual/BVCDiagramRenderer.astro';
import { evaluateBlockForVisualization } from '../lib/visual/visualApproval';
import { matchChapter13SvgToVisual } from '../lib/visual/chapter13Whitelist';

interface Props {
  chapter: any;
}

const { chapter } = Astro.props;
let html = await Astro.slots.render('default');

const chapterIdStr = chapter?.data?.chapterNumber 
  ? String(chapter.data.chapterNumber) 
  : (chapter?.id?.startsWith('13') || chapter?.slug?.startsWith('13') ? '13' : '');

const isChapter13 = chapterIdStr === '13';

// If Chapter 13, process image tags to enforce the strict 7-visual lock
if (isChapter13) {
  const imgRegex = /<p>\s*<img\s+([^>]*src="([^"]+)"[^>]*)>\s*<\/p>(?:\s*<p>\s*<em>(.*?)<\/em>(.*?)<\/p>)?/gi;
  
  html = html.replace(imgRegex, (_fullMatch, imgAttrs, src, captionTitle, captionRest) => {
    const approvedVisual = matchChapter13SvgToVisual(src);
    
    if (approvedVisual) {
      const fullCaption = approvedVisual.caption || (captionTitle ? (captionTitle + (captionRest || '')) : '');
      let captionHtml = '';
      if (fullCaption) {
        captionHtml = '<figcaption class="w-full text-center text-xs sm:text-sm text-[#64748B] leading-relaxed border-t border-[#e5eaf3] pt-4 px-2 sm:px-6 max-w-[680px]">' + fullCaption + '</figcaption>';
      }
      return '<figure id="' + approvedVisual.id + '" class="bvc-visual-frame my-10 w-full max-w-[840px] mx-auto flex flex-col items-center gap-6 select-none bg-white border border-[#e5eaf3] rounded-lg p-5 sm:p-6 md:p-8 shadow-[0_1px_3px_rgba(0,0,0,0.01)]">' +
        '<div class="w-full flex items-center justify-between border-b border-[#e5eaf3] pb-3 text-[10px] sm:text-xs font-mono uppercase tracking-wider text-[#64748B]">' +
          '<span class="text-[#081321] font-bold">' + approvedVisual.figType + ' ' + approvedVisual.figId + '</span>' +
          '<span class="text-[#64748B]">BEYOND VIBE CODING</span>' +
        '</div>' +
        '<div class="w-full flex justify-center items-center overflow-x-auto overflow-y-hidden py-2">' +
          '<img ' + imgAttrs + ' class="max-w-full h-auto" />' +
        '</div>' +
        captionHtml +
      '</figure>';
    } else {
      const title = captionTitle || 'Executor Capability Map';
      const cleanDesc = captionRest ? captionRest.replace(/^[\s\-]+/, '').trim() : 'Routing based on current eligibility and contract invariants.';
      return '<div class="bvc-textual-engineering-expression my-6 text-[#0B1D3A]">' +
        '<div class="font-bold text-[#0B1D3A] text-sm mb-1">' + title + '</div>' +
        '<div class="text-sm text-[#475569] leading-relaxed">' + cleanDesc + '</div>' +
      '</div>';
    }
  });
}

const regex = /<div class="bvc-visual-placeholder" data-type="([^"]+)" data-id="([^"]*)"(?:[^>]*)>([\s\S]*?)<\/div>/g;


interface Chunk {
  type: 'html' | 'visual';
  content?: string;
  visualType?: string;
  visualId?: string;
  rawParsedContent?: string;
  lines?: string[];
}

const chunks: Chunk[] = [];
let lastIndex = 0;
let match;

while ((match = regex.exec(html)) !== null) {
  if (match.index > lastIndex) {
    chunks.push({
      type: 'html',
      content: html.slice(lastIndex, match.index)
    });
  }

  const visualType = match[1];
  const visualId = match[2];
  const rawContent = match[3];

  const cleanedContent = rawContent
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/?[^>]+(>|$)/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"');

  const lines = cleanedContent
    .split('\n')
    .map(line => line.trim())
    .filter(line => line && line !== '↓' && line !== '↓');

  chunks.push({
    type: 'visual',
    visualType,
    visualId,
    rawParsedContent: cleanedContent,
    lines
  });

  lastIndex = regex.lastIndex;
}

if (lastIndex < html.length) {
  chunks.push({
    type: 'html',
    content: html.slice(lastIndex)
  });
}
---

<div class="prose-editorial-body w-full flex flex-col">
  {chunks.map((chunk, index) => {
    if (chunk.type === 'html') {
      return <Fragment set:html={chunk.content} />;
    } else if (chunk.type === 'visual') {
      // Determine if the previous chunk was also a visual for tighter spacing
      const isPrevVisual = index > 0 && chunks[index - 1].type === 'visual';
      const spacingClass = isPrevVisual ? "mt-4 mb-8" : "my-8";

      let visualComponent;
      
      if (chunk.visualType === 'text-diagram') {
        const evalResult = evaluateBlockForVisualization(chapterIdStr, chunk.rawParsedContent || '');
        if (evalResult.shouldRender) {
          visualComponent = <BVCDiagramRenderer content={chunk.rawParsedContent || ''} />;
        } else {
          const lines = (chunk.rawParsedContent || '').split('\n');
          visualComponent = (
            <div class="bvc-textual-engineering-expression">
              {lines.map((l: string) => {
                const trimmed = l.trim();
                if (trimmed === '↓' || trimmed === '→' || trimmed === '->' || trimmed === '=>') {
                  return <div class="bvc-textual-arrow text-[#0066CC] font-semibold">{trimmed}</div>;
                }
                return <div class="bvc-textual-line">{l}</div>;
              })}
            </div>
          );
        }
      } else {
        const isActionScope = chunk.visualType === 'action-scope';
        const isFlow = chunk.visualType === 'flow';
        
        const figId = chunk.visualId === 'V05-01' ? "05.1" : (chunk.visualId === 'V05-02' ? "05.2" : undefined);
        const figType = isActionScope ? "ARTIFACT" : "PROCESS";
        const caption = chunk.visualId === 'V05-01' 
          ? "Task Action Scope thiết lập ranh giới quyền hạn chi tiết cho các hoạt động đọc, ghi và thực thi của AI."
          : (chunk.visualId === 'V05-02' 
            ? "Vòng lặp thiết kế task có kiểm soát từ phân loại rủi ro đến bước thẩm định kết quả cuối cùng." 
            : undefined);

        visualComponent = (
          <BVCVisualFrame figId={figId} figType={figType} caption={caption} id={chunk.visualId} borderless={isActionScope}>
            {isActionScope && (
              <BVCActionScope 
                items={chunk.lines?.map(line => {
                  const colonIdx = line.indexOf(':');
                  if (colonIdx !== -1) {
                    return {
                      action: line.slice(0, colonIdx).trim(),
                      scope: line.slice(colonIdx + 1).trim()
                    };
                  }
                  return { action: "INFO", scope: line };
                })} 
              />
            )}
            {isFlow && (
              <BVCFlow steps={chunk.lines} />
            )}
          </BVCVisualFrame>
        );
      }

      return (
        <div class={`bvc-visual-wrapper ${spacingClass}`}>
          {visualComponent}
        </div>
      );
    }
  })}
</div>

