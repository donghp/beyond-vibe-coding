---
interface Props {
  author?: string;
  source?: string;
}

const { author, source } = Astro.props;
---

<div class="my-8 p-6 bg-[#f4f6fa] border-l-3 border-tech-blue rounded-r-lg shadow-sm max-w-[var(--reader-max-width)] relative group">
  <!-- Subtle background quote icon -->
  <div class="absolute right-4 top-4 text-navy-100 opacity-20 pointer-events-none transition-opacity group-hover:opacity-30">
    <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
    </svg>
  </div>
  
  <blockquote class="text-sm sm:text-base font-serif italic text-navy-800 leading-relaxed font-medium">
    <slot />
  </blockquote>
  
  {(author || source) && (
    <cite class="block mt-3 text-xs font-mono font-bold text-navy-400 not-italic uppercase tracking-wider">
      — {author}{source && <span class="font-medium text-navy-300">, {source}</span>}
    </cite>
  )}
</div>
