---
interface Props {
  title?: string;
}

const { title = "Key Concept" } = Astro.props;
---

<div class="my-8 p-5 bg-[#e6f7fa] border border-[#00b4d8]/15 rounded-md shadow-sm max-w-[var(--reader-max-width)] relative">
  <!-- Subtle icon header -->
  <div class="flex items-center gap-2 mb-2 pb-1.5 border-b border-[#00b4d8]/10">
    <!-- Star/Idea icon -->
    <svg class="w-4 h-4 text-tech-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>
    <span class="text-xs font-mono font-bold text-navy-900 uppercase tracking-wider">{title}</span>
  </div>

  <div class="text-sm leading-relaxed text-navy-800 font-medium">
    <slot />
  </div>
</div>
