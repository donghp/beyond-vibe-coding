---
// Prompt-ID: #000006
// Prompt-Title: BVC GLOBAL NAVIGATION — ACTIVE TAB / ROUTE-AWARE NAVIGATION FIX

import { joinBase } from '../utils/paths';

const pathname = Astro.url.pathname;
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

// Normalize path by stripping base URL and leading/trailing slashes
let normalized = pathname;
if (base && normalized.startsWith(base)) {
  normalized = normalized.slice(base.length);
}
const cleanPath = normalized.replace(/^\/+|\/+$/g, '');

// Determine active navigation tab based on canonical route mapping
type NavTab = 'chapters' | 'glossary' | 'about' | 'resources' | 'none';
let activeTab: NavTab = 'chapters';

if (cleanPath === 'about' || cleanPath.startsWith('about/')) {
  activeTab = 'about';
} else if (cleanPath === 'glossary' || cleanPath.startsWith('glossary/')) {
  activeTab = 'glossary';
} else if (cleanPath === 'resources' || cleanPath.startsWith('resources/')) {
  activeTab = 'resources';
} else if (
  cleanPath === '' || 
  cleanPath === 'chapters' || 
  cleanPath.startsWith('chapters/') || 
  cleanPath.startsWith('opening/')
) {
  activeTab = 'chapters';
} else {
  activeTab = 'none';
}

const navItems = [
  { id: 'chapters', label: 'Chapters', href: joinBase('#chapters') },
  { id: 'glossary', label: 'Glossary', href: joinBase('glossary') },
  { id: 'about', label: 'About', href: joinBase('about') },
  { id: 'resources', label: 'Resources', href: joinBase('#resources') }
];
---

<header class="sticky top-0 z-40 w-full h-[var(--header-height)] bg-[#fbfbfd]/95 backdrop-blur-md border-b border-navy-100 flex items-center justify-between px-6 transition-all duration-300 header-container">
  <!-- Brand Identity -->
  <a href={joinBase('')} class="flex flex-col select-none group focus:outline-none">
    <div class="flex items-center gap-1.5 text-base sm:text-lg font-black tracking-tight uppercase leading-none font-sans">
      <span class="text-navy-950">BEYOND</span>
      <span class="text-tech-blue">VIBE</span>
      <span class="text-navy-950">CODING</span>
    </div>
    <span class="text-[11px] text-navy-500 font-medium tracking-normal mt-0.5">An intentional way to build with AI</span>
  </a>

  <!-- Primary Book Navigation (Desktop & Large Screen) -->
  <nav class="hidden lg:flex items-center gap-8 text-xs font-bold select-none" aria-label="Global Navigation">
    {navItems.map((item) => {
      const isActive = activeTab === item.id;
      return (
        <a 
          href={item.href} 
          class={isActive 
            ? "text-navy-950 relative py-1 hover:text-tech-blue transition-colors duration-150 after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[2px] after:bg-tech-blue" 
            : "text-navy-600 hover:text-tech-blue transition-colors duration-150 relative py-1"
          }
          aria-current={isActive ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </nav>

  <!-- Right Actions: Search, GitHub Profile & Mobile Menu Toggle -->
  <div class="flex items-center gap-3 sm:gap-4">
    <!-- Styled Search Box -->
    <button 
      id="search-trigger-btn"
      class="flex items-center justify-between w-40 sm:w-64 px-3 py-1.5 text-xs text-navy-500 bg-white border border-navy-200 rounded-lg hover:border-tech-blue/40 hover:text-navy-700 transition-all duration-150 focus:outline-none cursor-pointer shadow-2xs"
      aria-label="Search Chapters (Ctrl+K)"
    >
      <div class="flex items-center gap-2 truncate">
        <svg class="w-3.5 h-3.5 text-navy-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="truncate text-[11px]">Search chapters, topics, ...</span>
      </div>
      <kbd class="hidden sm:inline-flex px-1.5 py-0.5 text-[10px] text-navy-400 bg-navy-50 border border-navy-200 rounded font-mono shrink-0">
        Ctrl K
      </kbd>
    </button>

    <!-- GitHub Donghp Profile Badge -->
    <a 
      href="https://github.com/donghp/beyond-vibe-coding" 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-navy-950 hover:text-tech-blue transition-colors duration-150 focus:outline-none select-none pl-1"
      aria-label="GitHub Repository"
      title="Source on GitHub"
    >
      <svg class="w-6 h-6 text-navy-950" viewBox="0 0 24 24" fill="currentColor">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
      </svg>
      <div class="hidden sm:flex flex-col text-left leading-tight">
        <span class="text-xs font-extrabold text-navy-950">GitHub</span>
        <span class="text-[10px] text-navy-500 font-mono">donghp</span>
      </div>
    </a>

    <!-- Mobile Menu Toggle Button (visible on < lg) -->
    <button 
      id="mobile-nav-toggle-btn"
      class="lg:hidden flex items-center justify-center w-8 h-8 text-navy-700 hover:text-navy-950 hover:bg-navy-100 rounded-lg transition-colors focus:outline-none cursor-pointer"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
    >
      <svg id="menu-icon-open" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div 
  id="mobile-nav-drawer" 
  class="hidden lg:hidden sticky top-[var(--header-height)] left-0 right-0 w-full bg-[#fbfbfd]/98 backdrop-blur-lg border-b border-navy-200 shadow-md py-3 px-6 z-30 transition-all duration-200"
  aria-label="Mobile Navigation"
>
  <nav class="flex flex-col gap-1 select-none">
    {navItems.map((item) => {
      const isActive = activeTab === item.id;
      return (
        <a 
          href={item.href}
          class={isActive
            ? "flex items-center justify-between px-3.5 py-2.5 rounded-lg bg-navy-100/80 text-navy-950 font-bold text-xs border-l-[3px] border-tech-blue"
            : "flex items-center justify-between px-3.5 py-2.5 rounded-lg text-navy-600 hover:text-navy-950 hover:bg-navy-50 font-medium text-xs transition-colors"
          }
          aria-current={isActive ? "page" : undefined}
        >
          <span>{item.label}</span>
          {isActive && (
            <span class="w-1.5 h-1.5 rounded-full bg-tech-blue"></span>
          )}
        </a>
      );
    })}
  </nav>
</div>

<script>
  // Mobile navigation drawer toggle
  const mobileNavToggleBtn = document.getElementById('mobile-nav-toggle-btn');
  const mobileNavDrawer = document.getElementById('mobile-nav-drawer');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  if (mobileNavToggleBtn && mobileNavDrawer) {
    mobileNavToggleBtn.addEventListener('click', () => {
      const isExpanded = mobileNavToggleBtn.getAttribute('aria-expanded') === 'true';
      const newState = !isExpanded;
      mobileNavToggleBtn.setAttribute('aria-expanded', String(newState));
      
      if (newState) {
        mobileNavDrawer.classList.remove('hidden');
        menuIconOpen?.classList.add('hidden');
        menuIconClose?.classList.remove('hidden');
      } else {
        mobileNavDrawer.classList.add('hidden');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
      }
    });

    // Close on click link
    mobileNavDrawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNavDrawer.classList.add('hidden');
        mobileNavToggleBtn.setAttribute('aria-expanded', 'false');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
      });
    });
  }

  // Trigger search dialog open event
  document.getElementById('search-trigger-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search-dialog'));
  });
</script>

<style>
  /* Header collapses nicely under book mode active classes */
  :global(.book-mode-active) .header-container {
    border-color: transparent;
    background-color: transparent;
  }
</style>

