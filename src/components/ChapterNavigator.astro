---
interface Props {
  slug: string;
  version: string;
  readingTime: string;
  topicCount?: number;
  navigationPolicy?: string;
}

const { slug, version, readingTime, topicCount = 5, navigationPolicy } = Astro.props;
const githubSourceUrl = `https://github.com/donghp/beyond-vibe-coding/blob/main/src/content/chapters/${slug}.md`;
---

<aside id="chapter-navigator" data-navigation-policy={navigationPolicy} class="w-full min-[1280px]:w-[var(--right-rail-width)] border-l border-navy-100 p-5 flex flex-col gap-5 select-none shrink-0 transition-all duration-300 right-rail-container bg-[#fcfdfe]">
  
  <!-- Book Mode Switch Toggle at Top of Right Rail (as in reference mockup) -->
  <div class="flex items-center justify-between pb-3 border-b border-navy-100">
    <div class="flex items-center gap-2 text-xs font-bold text-navy-800">
      <svg class="w-4 h-4 text-navy-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      <span>Book Mode</span>
    </div>
    
    <button 
      id="right-rail-book-mode-toggle"
      type="button" 
      role="switch" 
      aria-checked="false"
      class="w-9 h-5 bg-navy-200 rounded-full p-0.5 transition-colors duration-200 focus:outline-none cursor-pointer relative"
      title="Toggle Distraction-Free Book Mode (B)"
    >
      <span id="right-rail-toggle-dot" class="block w-4 h-4 rounded-full bg-white shadow-sm transition-transform duration-200"></span>
    </button>
  </div>

  <!-- "ON THIS CHAPTER" Section Navigator -->
  <div class="flex flex-col gap-2.5">
    <h3 class="text-[10px] font-bold tracking-widest text-navy-400 uppercase">
      On This Chapter
    </h3>
    
    <!-- Vertical navigation track with continuous vertical line -->
    <nav class="flex flex-col relative pl-5 border-l-2 border-navy-200 ml-1.5 mt-1 space-y-1" id="right-rail-anchors-nav">
      <div class="py-2 text-xs text-navy-400 font-medium italic animate-pulse">Scanning headings...</div>
    </nav>
  </div>

  <!-- READING PROGRESS Section -->
  <div class="flex flex-col gap-3 p-4 bg-white rounded-xl border border-navy-200/80 shadow-2xs">
    <div class="flex items-center justify-between">
      <span class="text-[10px] font-black tracking-wider text-navy-400 uppercase">Reading Progress</span>
      <span class="text-xs font-bold text-tech-blue font-mono" id="chapter-scroll-percentage">0%</span>
    </div>

    <!-- Progress Track -->
    <div class="w-full h-1.5 bg-navy-100 rounded-full overflow-hidden">
      <div id="chapter-scroll-bar" class="h-full bg-tech-blue rounded-full transition-all duration-150" style="width: 0%"></div>
    </div>

    <div class="flex flex-col gap-2 pt-2 border-t border-navy-100 text-xs text-navy-700">
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-navy-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span class="font-medium text-navy-800">~ 10 phút đọc</span>
      </div>
      
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-navy-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span class="font-medium text-navy-800">5 chủ đề chính</span>
      </div>

      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-navy-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="font-medium text-navy-800">Cập nhật lần cuối 09/2026</span>
      </div>
    </div>
  </div>

  <!-- Editorial Quote Card with large quotation mark -->
  <div class="p-4 rounded-xl bg-[#f0f6fc] border border-[#d0e1f7] text-xs text-navy-900 flex flex-col gap-2 relative overflow-hidden">
    <span class="text-3xl font-serif text-tech-blue font-black leading-none select-none">“</span>
    <p class="italic leading-relaxed font-medium">
      Trao cho AI nhiều khả năng hơn, không có nghĩa là buông bỏ kiểm soát. Đó là nghệ thuật của sự cân bằng.
    </p>
    <div class="flex items-center gap-1 text-[10px] font-bold text-navy-500 uppercase tracking-wider pt-1">
      <span class="w-3 h-[1px] bg-tech-blue inline-block"></span>
      <span>BEYOND VIBE CODING</span>
    </div>
  </div>

  <!-- GitHub Repository Card -->
  <div class="mt-auto">
    <a 
      href="https://github.com/donghp/beyond-vibe-coding"
      target="_blank"
      rel="noopener noreferrer"
      class="p-3 rounded-xl bg-white border border-navy-200/80 shadow-2xs hover:border-tech-blue/50 flex items-center justify-between transition-all group"
      title="Source on GitHub"
    >
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-navy-800 group-hover:text-tech-blue transition-colors" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <div class="flex flex-col text-left">
          <span class="text-[9px] font-black text-navy-400 uppercase tracking-widest leading-none">Source on GitHub</span>
          <span class="text-xs font-bold text-navy-950 group-hover:text-tech-blue transition-colors">github.com/donghp</span>
        </div>
      </div>
      <span class="text-navy-400 group-hover:text-tech-blue font-mono text-sm">↗</span>
    </a>
    
    <p class="text-[11px] text-navy-400 italic text-center mt-3 select-none">
      Open knowledge for a more intentional future.
    </p>
  </div>
</aside>

<script>
  // Book Mode switch handler
  function syncBookModeToggle() {
    const isBookMode = document.documentElement.classList.contains('book-mode-active');
    const toggleBtn = document.getElementById('right-rail-book-mode-toggle');
    const dot = document.getElementById('right-rail-toggle-dot');
    
    if (toggleBtn && dot) {
      if (isBookMode) {
        toggleBtn.classList.add('bg-tech-blue');
        toggleBtn.classList.remove('bg-navy-200');
        dot.classList.add('translate-x-4');
        toggleBtn.setAttribute('aria-checked', 'true');
      } else {
        toggleBtn.classList.remove('bg-tech-blue');
        toggleBtn.classList.add('bg-navy-200');
        dot.classList.remove('translate-x-4');
        toggleBtn.setAttribute('aria-checked', 'false');
      }
    }
  }

  syncBookModeToggle();
  window.addEventListener('book-mode-changed', syncBookModeToggle);

  document.getElementById('right-rail-book-mode-toggle')?.addEventListener('click', () => {
    const isActive = document.documentElement.classList.toggle('book-mode-active');
    localStorage.setItem('beyond-vibe-book-mode', String(isActive));
    window.dispatchEvent(new CustomEvent('book-mode-changed', { detail: { isActive } }));
    syncBookModeToggle();
  });

  // Client-side dynamic Table of Contents generation & Scroll Spy
  function buildTOC() {
    const parentContainer = document.getElementById('right-rail-anchors-nav');
    const contentBody = document.getElementById('chapter-content-body');
    const chapterNav = document.getElementById('chapter-navigator');
    
    if (!parentContainer || !contentBody) return;

    const navPolicy = chapterNav?.getAttribute('data-navigation-policy');
    if (navPolicy === 'NO_NAVIGATION_TREE_FOR_FOREWORD') {
      parentContainer.innerHTML = '<div class="text-xs text-navy-400 py-2 italic font-sans">Lời mở đầu — Toàn văn</div>';
      spyScroll();
      return;
    }

    // Extract all H2 elements from content
    const headings = Array.from(contentBody.querySelectorAll('h2'));

    if (headings.length === 0) {
      parentContainer.innerHTML = '<div class="text-xs text-navy-400 py-2">No sections defined</div>';
      return;
    }

    // Map headings into elements
    parentContainer.innerHTML = '';
    
    headings.forEach((heading, idx) => {
      // Ensure heading has an ID anchor. If not, generate one
      let id = heading.id;
      if (!id) {
        id = heading.textContent?.toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-') || `sec-${idx}`;
        heading.id = id;
      }

      const text = heading.textContent?.trim() || '';
      let mainText = text;
      let subText = '';
      if (text.includes(':')) {
        const parts = text.split(':');
        mainText = parts[0].trim();
        subText = parts.slice(1).join(':').trim();
      }

      const anchor = document.createElement('a');
      anchor.href = `#${id}`;
      anchor.className = `group flex items-start py-1.5 pl-7 text-xs text-navy-700 hover:text-navy-950 transition-colors duration-150 focus:outline-none relative right-rail-toc-item cursor-pointer leading-snug`;
      anchor.setAttribute('data-target-id', id);
      
      // Circular section node with clear separation between marker and text
      anchor.innerHTML = `
        <span class="w-2.5 h-2.5 rounded-full bg-white border-2 border-navy-300 absolute left-3 -translate-x-1/2 top-2 transition-all duration-200 toc-bullet group-hover:border-navy-600"></span>
        <div class="flex flex-col min-w-0 pr-1">
          <span class="toc-title font-medium">${mainText}</span>
          ${subText ? `<span class="text-[10px] text-navy-400 font-normal leading-tight mt-0.5">${subText}</span>` : ''}
        </div>
      `;

      parentContainer.appendChild(anchor);
    });

    // Run active Spy calculation immediately
    spyScroll();
  }

  function spyScroll() {
    const items = document.querySelectorAll('.right-rail-toc-item');
    const contentBody = document.getElementById('chapter-content-body');
    if (!contentBody) return;

    // Calculate reading scroll progress percentage
    const readerArticle = document.getElementById('chapter-reader');
    if (readerArticle) {
      const rect = readerArticle.getBoundingClientRect();
      const totalHeight = rect.height - window.innerHeight;
      let progress = 0;
      if (totalHeight > 0) {
        progress = Math.min(100, Math.max(0, Math.round((-rect.top / totalHeight) * 100)));
      } else if (rect.top <= 0) {
        progress = 100;
      }
      const percentEl = document.getElementById('chapter-scroll-percentage');
      const barEl = document.getElementById('chapter-scroll-bar');
      if (percentEl) percentEl.textContent = `${progress}%`;
      if (barEl) barEl.style.width = `${progress}%`;
    }

    if (items.length === 0) return;

    const headings = Array.from(contentBody.querySelectorAll('h2'));
    const scrollPosition = window.scrollY + 140;

    let activeId = '';

    for (let i = 0; i < headings.length; i++) {
      const heading = headings[i];
      const offsetTop = heading.getBoundingClientRect().top + window.scrollY;

      if (scrollPosition >= offsetTop) {
        activeId = heading.id;
      } else {
        break;
      }
    }

    if (!activeId && headings.length > 0) {
      activeId = headings[0].id;
    }

    items.forEach((item) => {
      const targetId = item.getAttribute('data-target-id');
      const bullet = item.querySelector('.toc-bullet');
      const titleEl = item.querySelector('.toc-title');
      
      if (targetId === activeId) {
        item.classList.add('text-tech-blue');
        item.classList.remove('text-navy-700');
        if (titleEl) {
          titleEl.classList.add('text-tech-blue', 'font-bold');
          titleEl.classList.remove('font-medium');
        }
        if (bullet) {
          bullet.classList.add('bg-tech-blue', 'border-tech-blue', 'scale-125', 'ring-2', 'ring-blue-100');
          bullet.classList.remove('bg-white', 'border-navy-300');
        }
      } else {
        item.classList.remove('text-tech-blue');
        item.classList.add('text-navy-700');
        if (titleEl) {
          titleEl.classList.remove('text-tech-blue', 'font-bold');
          titleEl.classList.add('font-medium');
        }
        if (bullet) {
          bullet.classList.remove('bg-tech-blue', 'border-tech-blue', 'scale-125', 'ring-2', 'ring-blue-100');
          bullet.classList.add('bg-white', 'border-navy-300');
        }
      }
    });
  }

  // Build TOC on load
  buildTOC();

  // Listen to scrolls for Spy
  window.addEventListener('scroll', spyScroll, { passive: true });
</script>

<style>
  /* Collapse right-rail in Book Mode on Desktop */
  :global(.book-mode-active) .right-rail-container {
    width: 0px !important;
    padding-left: 0px !important;
    padding-right: 0px !important;
    border-left-width: 0px !important;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Transition timings for clean collapses */
  .right-rail-container {
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                padding 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                border 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 0.2s ease-out;
  }
</style>
