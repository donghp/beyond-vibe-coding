{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/donghp/beyond-vibe-coding/blob/main/specifications/v0.1/change-record.schema.json",
  "title": "BVC Change Record",
  "description": "Draft v0.1.0 record of observed repository changes for a task execution. The record should be produced from a trusted version-control diff collector; self-reported Worker summaries are not authoritative change inventories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "record_status",
    "project_id",
    "task_ref",
    "contract_ref",
    "execution_ref",
    "baseline",
    "collector",
    "changes",
    "totals",
    "scope_integrity",
    "change_budget_result",
    "findings",
    "limitations"
  ],
  "properties": {
    "record_version": {
      "const": "0.1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "record_status": {
      "enum": [
        "DRAFT",
        "FINAL",
        "REJECTED"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "task_id"
      ]
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "revision"
      ]
    },
    "execution_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "executor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "run_id",
        "executor_id",
        "started_at"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "target_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "working_tree_status": {
          "enum": [
            "CLEAN",
            "DIRTY"
          ]
        },
        "pre_existing_changes_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "source_commit",
        "working_tree_status"
      ]
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GIT_DIFF",
            "VCS_API",
            "OTHER"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "trust_level": {
          "enum": [
            "TRUSTED",
            "UNVERIFIED"
          ]
        },
        "source_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "method",
        "name",
        "version",
        "collected_at",
        "trust_level"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$"
          },
          "operation": {
            "enum": [
              "CREATE",
              "MODIFY",
              "DELETE"
            ]
          },
          "additions": {
            "type": "integer",
            "minimum": 0
          },
          "deletions": {
            "type": "integer",
            "minimum": 0
          },
          "is_binary": {
            "type": "boolean"
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "dependency",
                "lockfile",
                "database_schema",
                "financial_formula",
                "authentication",
                "architecture"
              ]
            },
            "minItems": 0,
            "maxItems": 20
          },
          "before_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "after_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "diff_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "path",
          "operation",
          "additions",
          "deletions",
          "is_binary",
          "categories"
        ]
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed_files": {
          "type": "integer",
          "minimum": 0
        },
        "created_files": {
          "type": "integer",
          "minimum": 0
        },
        "modified_files": {
          "type": "integer",
          "minimum": 0
        },
        "deleted_files": {
          "type": "integer",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "diff_lines": {
          "type": "integer",
          "minimum": 0
        },
        "binary_files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "changed_files",
        "created_files",
        "modified_files",
        "deleted_files",
        "additions",
        "deletions",
        "diff_lines",
        "binary_files"
      ]
    },
    "scope_integrity": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED"
      ]
    },
    "change_budget_result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "ERROR",
              "CRITICAL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 100
    }
  }
}
